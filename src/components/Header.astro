---
// Markup identical to the WP header (header.php + wp_nav_menu "main-nav" output), so the
// original theme CSS (public/wp-theme/css) and JS (agitech-theme.js) apply untouched.
// FR/EN menus are the live WP menus; NL has no WP counterpart, it mirrors the EN structure.
import { switcherLinks } from '../lib/translations.mjs';
import { navigation } from '../lib/settings';
export interface Props {
  lang: 'fr' | 'en' | 'nl';
}
const { lang } = Astro.props;

// Menu texts and links come from the "Navigation" settings (one tree per language, three levels like the WP menu).
const { items, discuss, discussHref } = navigation[lang];
// Language flags: WordPress offered the other language; NL has no WP counterpart and offers FR and EN. Each flag points
// to this page's translation (translationKey), or to the other language's home when it has none.
const FLAGS = { fr: ['en'], en: ['fr'], nl: ['fr', 'en'] } as const;
const FLAG_ALT = { fr: 'Français', en: 'English' } as const;
const links = switcherLinks(Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`);
const flags = FLAGS[lang].map((img) => ({ img, alt: FLAG_ALT[img], href: links[img] }));
const home = lang === 'fr' ? '/' : `/${lang}/`;
const contact = discussHref;
const current = Astro.url.pathname;
---
<header>
<div class="container">
    <div class="header-wrap">
        <div class="logo">
            <a href={home}>
                <img src="/wp-content/uploads/2025/06/agitech-white-logo.svg" alt="agitech-white-logo">
            </a>
        </div>
        <div class="navigation">
            <a href={home} class="lines-button"><span class="lines"></span></a>
            <div class="main_menu">
                <div class={`menu-top-header-menu-${lang}-container`}><ul id={`menu-top-header-menu-${lang}`} class="menu">
                    {items.map((item) => (
                        <li class:list={['menu-item', item.children.length > 0 && 'menu-item-has-children', item.href === current && 'current-menu-item']}>
                            <a href={item.href}>{item.label}</a>
                            {item.children.length > 0 && <span class="dropdown-arrow"></span>}
                            {item.children.length > 0 && (
                                <ul class="sub-menu">
                                    {item.children.map((sub) => (
                                        <li class:list={['menu-item', sub.children.length > 0 && 'menu-item-has-children']}>
                                            <a href={sub.href}>{sub.label}</a>
                                            {sub.children.length > 0 && (
                                                <ul class="sub-menu">
                                                    {sub.children.map((leaf) => (
                                                        <li class:list={['menu-item', leaf.href === current && 'current-menu-item']}><a href={leaf.href}>{leaf.label}</a></li>
                                                    ))}
                                                </ul>
                                            )}
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </li>
                    ))}
                    {flags.map((f) => (
                        <li class={`lang-item lang-item-${f.img} menu-item`}>
                            <a href={f.href} hreflang={f.img} lang={f.img}><img src={`/wp-theme/images/flags/${f.img}.png`} alt={f.alt} width="16" height="11" style="width: 16px; height: 11px;"></a>
                        </li>
                    ))}
                </ul></div>
                <div class="discuss-btn">
                    <a href={contact}>{discuss}</a>
                </div>
            </div>
        </div>
    </div>
</div>
</header>
