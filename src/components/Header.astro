---
export interface Props {
  lang: 'fr' | 'en' | 'nl';
}
const { lang } = Astro.props;

import { getNav } from '../lib/nav';
const { strings, industries, services } = getNav(lang);
const base = lang === 'fr' ? '' : `/${lang}`;
import { switcherUrls } from '../lib/localePaths';
const langUrls = await switcherUrls(Astro.url.pathname);
const LANG_OPTIONS = [
  { code: 'fr', label: 'FR', name: 'Français' },
  { code: 'en', label: 'EN', name: 'English' },
  { code: 'nl', label: 'NL', name: 'Nederlands' },
] as const;
---
<header>
  <div class="container header-wrap">
    <a class="logo" href={lang === 'fr' ? '/' : `${base}/`}>
      <img src="/assets/img/blocks/Agitech_LogoWhite_footer.svg" alt="Agitech">
    </a>
    <nav class="main_menu" id="mainMenu">
      <ul>
        <li><a href={`${base}/odoo-erp/`}>{strings.odoo}</a></li>
        <li class="has-submenu">
          <a href={`${base}/industries/`}>{strings.industries}</a>
          <button type="button" class="submenu-toggle" aria-expanded="false" aria-label={strings.industries}></button>
          <div class="submenu">
            <ul class="submenu-inner">
              {industries.map(i => <li><a href={i.href}>{i.label}</a></li>)}
              <li class="submenu-all"><a href={`${base}/industries/`}>{strings.allIndustries}</a></li>
            </ul>
          </div>
        </li>
        <li class="has-submenu">
          <a href={`${base}/odoo-erp/`}>{strings.services}</a>
          <button type="button" class="submenu-toggle" aria-expanded="false" aria-label={strings.services}></button>
          <div class="submenu">
            <ul class="submenu-inner">
              {services.map(s => <li><a href={s.href} target={s.external ? '_blank' : undefined} rel={s.external ? 'noopener' : undefined}>{s.label}</a></li>)}
            </ul>
          </div>
        </li>
        <li><a href={`${base}/business-cases/`}>{strings.cases}</a></li>
        <li><a href={`${base}/blog/`}>{strings.blog}</a></li>
        <li><a href={`${base}/jobs/`}>{strings.team}</a></li>
      </ul>
      <div class="lang-flag" role="group" aria-label="Langue / Language / Taal">
        {LANG_OPTIONS.map(o => o.code === lang
          ? <span class="lang-opt active" aria-current="true" lang={o.code}>{o.label}</span>
          : <a class="lang-opt" href={langUrls[o.code]} hreflang={o.code} lang={o.code} title={o.name}>{o.label}</a>)}
      </div>
      <div class="discuss-btn">
        <a href={`${base}/contact-us/`}>
          {strings.contact}
          <span class="discuss-btn-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M1 8h19M14 2l7 6-7 6"></path></svg>
          </span>
        </a>
      </div>
    </nav>
    <div class="lines-button" id="burgerBtn"><span class="lines"></span></div>
  </div>
</header>
