---
// Ported from the live WP footer (footer.php via get_footer()) — newsletter signup,
// tagline, real company address, ShiftingPact partner badge, social icons, nav, legal.
export interface Props {
  lang: 'fr' | 'en' | 'nl';
}
const { lang } = Astro.props;
import { getNav } from '../lib/nav';
const nav = getNav(lang);
const base = lang === 'fr' ? '' : `/${lang}`;
const strings = {
  fr: {
    newsletter: 'Abonnez-vous à notre newsletter', emailPlaceholder: 'Entrez votre email',
    tagline: 'Solutions informatiques fiables, pour entreprises performantes.',
    nav: 'Navigation',
    odoo: 'Odoo ERP', dev: 'Développement', infra: 'Infrastructure IT', cases: 'Réalisations', recruitment: 'Recrutement',
    rights: `© ${new Date().getFullYear()} Agitech. Tous droits réservés.`,
    privacy: 'Politique de Confidentialité', terms: 'Termes et Conditions', cookies: 'Gérer les cookies',
    otherOffices: 'Voir nos 3 bureaux',
  },
  en: {
    newsletter: 'Subscribe to our newsletter', emailPlaceholder: 'Enter your email',
    tagline: 'Reliable IT solutions, for high-performing SMEs.',
    nav: 'Navigation',
    odoo: 'Odoo ERP', dev: 'Development', infra: 'IT Infrastructure', cases: 'Case Studies', recruitment: 'Recruitment',
    rights: `© ${new Date().getFullYear()} Agitech. All rights reserved.`,
    privacy: 'Privacy Policy', terms: 'Terms & Conditions', cookies: 'Manage cookies',
    otherOffices: 'See our 3 offices',
  },
  nl: {
    newsletter: 'Schrijf u in op onze nieuwsbrief', emailPlaceholder: 'Vul uw e-mail in',
    tagline: 'Betrouwbare IT-oplossingen, voor performante KMO\'s.',
    nav: 'Navigatie',
    odoo: 'Odoo ERP', dev: 'Ontwikkeling', infra: 'IT-infrastructuur', cases: 'Realisaties', recruitment: 'Vacatures',
    rights: `© ${new Date().getFullYear()} Agitech. Alle rechten voorbehouden.`,
    privacy: 'Privacybeleid', terms: 'Algemene Voorwaarden', cookies: 'Cookies beheren',
    otherOffices: 'Bekijk onze 3 kantoren',
  },
}[lang];
---
<div class="brand-bar"></div>
<footer>
  <div class="container">
    <div class="row main-row">
      <div class="item logo-sub">
        <a class="ft-logo" href={lang === 'fr' ? '/' : `${base}/`}>
          <img src="/assets/img/blocks/Agitech_LogoWhite_footer.svg" alt="Agitech">
        </a>
        <div class="content">
          <h6>{strings.newsletter}</h6>
          <!-- Real submit endpoint (Formspree, like agifid) to be wired later. -->
          <form class="tnp-subscription" action="https://formspree.io/f/mwlvgnqo" method="POST">
            <input class="tnp-email" type="email" name="email" placeholder={strings.emailPlaceholder} required>
            <button class="tnp-submit" type="submit">→</button>
          </form>
        </div>
      </div>
      <div class="item company-location">
        <div class="top-text"><h5>{strings.tagline}</h5></div>
        <div class="content">
          <div class="address">
            <h6>Agitech Belgium</h6>
            <p>Clos Lucien Outers 11, 1160<br>Bruxelles, Belgique</p>
            <a class="other-offices-link" href={`${base}/#bureaux`}>{strings.otherOffices}</a>
          </div>
        </div>
      </div>
      <div class="item ft-links">
        <div class="content ft-nav-cols">
          <div>
            <h6>{strings.nav}</h6>
            <ul>
              <li><a href={`${base}/odoo-erp/`}>{nav.strings.odoo}</a></li>
              <li><a href={`${base}/business-cases/`}>{nav.strings.cases}</a></li>
              <li><a href={`${base}/blog/`}>{nav.strings.blog}</a></li>
              <li><a href={`${base}/jobs/`}>{nav.strings.team}</a></li>
              <li><a href={`${base}/contact-us/`}>{nav.strings.contact}</a></li>
            </ul>
          </div>
          <div>
            <h6><a href={`${base}/industries/`}>{nav.strings.industries}</a></h6>
            <ul>
              {nav.industries.map(i => <li><a href={i.href}>{i.label}</a></li>)}
            </ul>
          </div>
          <div>
            <h6>{nav.strings.services}</h6>
            <ul>
              {nav.services.map(s => <li><a href={s.href} target={s.external ? '_blank' : undefined} rel={s.external ? 'noopener' : undefined}>{s.label}</a></li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="copy-right">
      <div class="copy-left">
        <div class="social-icons">
          <a href="https://www.linkedin.com/company/agitechbelgium/" target="_blank" rel="noopener"><img src="/assets/img/blocks/linkedin.svg" alt="LinkedIn"></a>
          <a href="https://www.youtube.com/@Agitech-OdooPartner" target="_blank" rel="noopener"><img src="/assets/img/blocks/youtube.svg" alt="YouTube"></a>
          <a href="https://wa.me/32460241589" target="_blank" rel="noopener"><img src="/assets/img/blocks/whatsap.svg" alt="WhatsApp"></a>
        </div>
        <p>{strings.rights}</p>
      </div>
      <a class="shiftingpact-logo" href="https://shiftingpact.be/agitech/" target="_blank" rel="noopener">
        <img src="/assets/img/blocks/shiftingpackt-logo.png" alt="ShiftingPact">
      </a>
      <p class="privacy-links"><a href={`${base}/privacy-policy/`}>{strings.privacy}</a>&nbsp;|&nbsp;<a href={`${base}/terms-conditions/`}>{strings.terms}</a>&nbsp;|&nbsp;<a href="#" data-cookie-settings>{strings.cookies}</a></p>
    </div>
  </div>
</footer>
