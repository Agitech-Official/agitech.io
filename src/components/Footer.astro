---
// Markup identical to the WP footer (footer.php), so the original theme CSS applies untouched.
// Copy follows the live WP footer; the few WP slips (English placeholder and address on the FR
// page, "Agitech Belgique" on the EN page, "Termes et Conditionss") are fixed on purpose.
export interface Props {
  lang: 'fr' | 'en' | 'nl';
}
import { FORM_ENDPOINT, NEWSLETTER_SUBJECT } from '../lib/forms';
import { footer, site } from '../lib/settings';
import { blockImg, blockAlt } from '../lib/img';
import { switcherLinks } from '../lib/translations.mjs';
const { lang } = Astro.props;
const year = new Date().getFullYear();

// Texts and links come from the "Pied de page" settings (per language) and "Réglages du site" (social networks).
const f = footer[lang];
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const address = f.addressLines.map(esc).join(' <br>');
const links = switcherLinks(Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`);
const flags = {
  fr: [{ img: 'en', label: 'English' }],
  en: [{ img: 'fr', label: 'Français' }],
  nl: [{ img: 'fr', label: 'Français' }, { img: 'en', label: 'English' }],
}[lang].map((fl) => ({ ...fl, href: links[fl.img as 'fr' | 'en'] }));
---
<footer class="footer-section dark-bg top-line-img">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 col-md-4 col-sm-12 col-12 item">
                <div class="item-wrap logo-sub">
                    <div class="ft-logo top-text">
                        <a href={lang === 'fr' ? '/' : `/${lang}/`}><img
                            src="/assets/img/site/Agitech_LogoWhite_footer.svg"
                            alt="Agitech_LogoWhite_footer">
                        </a>
                    </div>
                    <div class="content">
                        <h6>{f.newsletterTitle}</h6>
                        <div class="tnp tnp-subscription ">
                            <!-- Same Formspree endpoint as before (src/lib/forms.ts); forms are reworked in a later phase. -->
                            <form method="post" action={FORM_ENDPOINT}>
                                <input type="hidden" name="_subject" value={NEWSLETTER_SUBJECT}>
                                <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none">
                                <div class="tnp-field tnp-field-email">
                                    <input class="tnp-email" type="email" name="email" id="tnp-1" value="" placeholder={f.emailPlaceholder} required>
                                </div>
                                <div class="tnp-field tnp-field-button" style="text-align: left"><button class="tnp-submit" type="submit">&gt;</button></div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-5 col-sm-12 col-12 item">
                <div class="item-wrap company-location">
                    <div class="top-text">
                        <h5>{f.tagline}</h5>
                    </div>
                    <div class="content">
                        <div class="row">
                            <div class="col-lg-6 col-6 col-sm-12 col-12 address">
                                <h6>{f.companyName}</h6>
                                <p set:html={address} />
                            </div>
                            <div class="col-lg-6 col-6 col-sm-12 col-12 ms-auto ml-auto address shiftingpact-logo">
                                <a href="https://shiftingpact.be/agitech/" target="_blank" rel="noopener"><img
                                    src="/assets/img/site/shiftingpackt-logo.png"
                                    alt="shiftingpackt-logo">
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-3 col-sm-12 col-12 item row">
                <div class="item-wrap ft-links">
                    <div class="top-text social-icons">
                        {site.socialLinks.map((n) => (
                        <a href={n.url} target="_blank" rel="noopener">
                            <img src={blockImg(n.icon)} alt={blockAlt(n.icon, n.label)}>
                        </a>
                        ))}
                    </div>
                    <div class="content">
                        <h6>{f.navTitle}</h6>
                        <div class={`menu-footer-links-menu-${lang}-container`}><ul id={`menu-footer-links-menu-${lang}`} class="menu">
                            {f.links.map((l) => <li class="menu-item"><a href={l.href}>{l.label}</a></li>)}
                        </ul></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row copy-right">
            <div class="col-lg-4 col-md-4 col-sm-12 col-12 item">
                <div class="flag-icon">
                    <div class={`menu-languages-${lang}-container`}><ul id={`menu-languages-${lang}`} class="menu">
                        {flags.map((f) => (
                            <li class={`lang-item lang-item-${f.img} menu-item`}><a href={f.href} hreflang={f.img} lang={f.img}><img src={`/wp-theme/images/flags/${f.img}.png`} alt="" width="16" height="11" style="width: 16px; height: 11px;"><span style="margin-left:0.3em;">{f.label}</span></a></li>
                        ))}
                    </ul></div>
                </div>
            </div>
            <div class="col-lg-4 col-md-4 col-sm-12 col-12 item">
                <p>&copy; {year} {site.companyName}. {f.rights}</p>
            </div>
            <div class="col-lg-4 col-md-4 col-sm-12 col-12 item text-end privacy-links">
                <p><a href={f.privacyHref}>{f.privacyLabel}</a>&nbsp;|&nbsp;<a href={f.termsHref}>{f.termsLabel}</a></p>
            </div>
        </div>
    </div>
</footer>
