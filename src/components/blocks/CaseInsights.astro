---
// Ported from template-parts/block/case-insights.php
import { blockImg, blockAlt } from '../../lib/img';
export interface Props {
  insights?: {
    heading?: string;
    content?: string;
    imageToDisplay?: '1' | '2';
    image?: string;
    image1?: string;
    image2?: string;
  }[];
}
const { insights = [] } = Astro.props;
---
<section class="custom-development-section">
  <div class="container">
    {insights.map(row => (
      <div class="row content">
        <div class="col-lg-4 col-md-3 col-sm-12 col-12">
          <div class="left-content">{row.heading && <h6>{row.heading}</h6>}</div>
        </div>
        <div class="col-lg-8 col-md-9 col-sm-12 col-12">
          <div class="right-content">
            {row.content && <div class="text" set:html={row.content} />}
            {row.imageToDisplay === '1' && row.image && (
              <div class="img d-inline-flex"><img src={blockImg(row.image)} alt={blockAlt(row.image)} class="devlopment-1"></div>
            )}
            {row.imageToDisplay === '2' && (row.image1 || row.image2) && (
              <div class="img d-inline-flex">
                {row.image1 && <img src={blockImg(row.image1)} alt={blockAlt(row.image1)} class="devlopment-2">}
                {row.image2 && <img src={blockImg(row.image2)} alt={blockAlt(row.image2)} class="devlopment-3">}
              </div>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
