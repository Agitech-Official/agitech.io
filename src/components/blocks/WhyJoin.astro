---
// Ported from template-parts/block/why-join.php
import { blockImg, blockAlt } from '../../lib/img';
export interface Props {
  leftTitle?: string;
  mainTitle?: string;
  content?: string;
  perks?: { icon?: string; title?: string; points?: string }[];
  image?: string;
}
const { leftTitle, mainTitle, content, perks = [], image } = Astro.props;
---
<section class="recruitment-section">
  <div class="container">
    <div class="row">
      {leftTitle && (
        <div class="col-lg-3 col-md-3 col-sm-12 col-12">
          <div class="left-content"><h6>{leftTitle}</h6></div>
        </div>
      )}
      <div class="col-lg-9 col-md-9 col-sm-12 col-12">
        <div class="right-content">
          {mainTitle && <h3>{mainTitle}</h3>}
          {content && <Fragment set:html={content} />}
          {perks.length > 0 && (
            <div class="row lists-wrap">
              {perks.map(p => (
                <div class="col-lg-6 col-md-6 col-12">
                  <div class="perks-list">
                    {p.icon && <div class="img"><img src={blockImg(p.icon)} alt={blockAlt(p.icon)}></div>}
                    {p.title && <h6>{p.title}</h6>}
                    {p.points && <Fragment set:html={p.points} />}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
    {image && (
      <div class="row image-container"><div class="img"><img src={blockImg(image)} alt={blockAlt(image)}></div></div>
    )}
  </div>
</section>
