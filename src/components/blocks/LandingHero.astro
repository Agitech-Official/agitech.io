---
// Ported from template-parts/block/landing-hero.php
import Cta from './Cta.astro';
import { blockImg } from '../../lib/img';
export interface Props {
  kpis?: { heading?: string; description?: string }[];
  title?: string;
  subTitle?: string;
  cta?: { label?: string; url?: string; newTab?: boolean };
  bgImage?: string;
  bottomLine?: boolean;
}
const { kpis = [], title, subTitle, cta, bgImage, bottomLine = false } = Astro.props;
---
<section class={`banner-sec inner-pages-banner landing-hero dark-bg ${bottomLine ? 'bottom-line-img' : ''}`}>
  <div class="container">
    <div class="row">
      <div class="col-lg-12 col-md-12 col-sm-12 col-12">
        {kpis.length > 0 && (
          <div class="kpis-container">
            {kpis.map(k => (
              <div class="kpi-item">
                <h5 class="kpi-heading">{k.heading}</h5>
                <p class="kpi-desc">{k.description}</p>
              </div>
            ))}
          </div>
        )}
        <div class="text">
          {title && <h6>{title}</h6>}
          {subTitle && <h1 set:html={subTitle} />}
          {cta && <Cta label={cta.label} url={cta.url} newTab={cta.newTab} wrapClass="light-btn" />}
        </div>
      </div>
    </div>
  </div>
  {bgImage && <div class="right-img bg-full-img"><img src={blockImg(bgImage)} alt=""></div>}
</section>
