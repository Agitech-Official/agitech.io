---
// Ported from template-parts/block/landing-hero.php (.right-img is always rendered, like in WP)
import Cta from './Cta.astro';
import { blockImg, blockAlt } from '../../lib/img';
export interface Props {
  kpis?: { heading?: string; description?: string }[];
  title?: string;
  subTitle?: string;
  cta?: { label?: string; url?: string; newTab?: boolean; calendly?: boolean };
  bgImage?: string;
  bottomLine?: boolean;
}
const { kpis = [], title, subTitle, cta, bgImage, bottomLine = false } = Astro.props;
---
<section class={`banner-sec inner-pages-banner landing-hero dark-bg ${bottomLine ? 'bottom-line-img' : ''}`}>
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                {kpis.length > 0 && (
                <div class="kpis-container">
                    {kpis.map(k => (
                      <div class="kpi-item">
                        <h5 class="kpi-heading">{k.heading}</h5>
                        <p class="kpi-desc">{k.description}</p>
                      </div>
                    ))}
                </div>
                )}
                <div class="text">
                    {title && <h6>{title}</h6>}
                    {subTitle && <h2 set:html={subTitle} />}
                    {cta && <Cta label={cta.label} url={cta.url} newTab={cta.newTab} calendly={cta.calendly} wrapClass="light-btn" />}
                </div>
            </div>
        </div>
    </div>
    <div class="right-img bg-full-img">
        {/* WP serves this image inside a <picture> (Imagify): the wrapper changes how the theme CSS sizes it */}
        {bgImage && <picture><img src={blockImg(bgImage)} alt={blockAlt(bgImage)}></picture>}
    </div>
</section>
