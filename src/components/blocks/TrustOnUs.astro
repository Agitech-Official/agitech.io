---
// Ported from template-parts/block/trust-on-us.php (the primary-btn wrapper is always rendered,
// like in WP, even when there is no button: the theme CSS spaces the section with it).
import { blockImg, blockAlt } from '../../lib/img';
export interface Props {
  title?: string;
  subTitle?: string;
  logos?: string[];
  cta?: { label?: string; url?: string; newTab?: boolean; calendly?: boolean };
}
const { title, subTitle, logos = [], cta } = Astro.props;
---
<section class="trust-us-section lighten-bg">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 ms-auto col-md-12 col-sm-12 col-12 company-logos">
                    <div class="title">
                        {title && <h3>{title}</h3>}
                        {subTitle && <h6>{subTitle}</h6>}
                    </div>
                    {logos.length > 0 && (
                        <div class="companies-logos">
                            {logos.map(logo => (
                                <div class="item"><img src={blockImg(logo)} alt={blockAlt(logo)}></div>
                            ))}
                        </div>
                    )}
                    <div class="primary-btn">
                        {cta?.label && cta?.url && <a href={cta.url} target={cta.newTab ? '_blank' : undefined} rel={cta.newTab ? 'noopener' : undefined}>{cta.label}</a>}
                    </div>
                </div>
            </div>
        </div>
    </section>
