---
// Ported from template-parts/block/trust-on-us.php
import Cta from './Cta.astro';
import { blockImg, altFromFile } from '../../lib/img';
export interface Props {
  title?: string;
  subTitle?: string;
  logos?: string[];
  cta?: { label?: string; url?: string; newTab?: boolean };
}
const { title, subTitle, logos = [], cta } = Astro.props;
---
<section class="trust-us-section lighten-bg">
  <div class="container">
    <div class="row">
      <div class="col-lg-12 ms-auto col-md-12 col-sm-12 col-12 company-logos">
        <div class="title">
          {title && <h3>{title}</h3>}
          {subTitle && <h6>{subTitle}</h6>}
        </div>
        {logos.length > 0 && (
          <div class="companies-logos">
            {logos.map(logo => (
              <div class="item"><img src={blockImg(logo)} alt={altFromFile(logo)}></div>
            ))}
          </div>
        )}
        {cta && <Cta label={cta.label} url={cta.url} newTab={cta.newTab} />}
      </div>
    </div>
  </div>
</section>
