---
// Ported from template-parts/block/our-services.php (the whole card is the link, like in WP).
// The pricing-tier variant Astro had added (price, included/excluded features) is gone: it was only
// used by the homepage, which is back to the WP "Nos services & solutions" cards.
export interface Props {
  title?: string;
  subTitle?: string;
  services?: { title?: string; link?: string; linkLabel?: string; features?: { text?: string }[] }[];
}
const { title, subTitle, services = [] } = Astro.props;
---
<section class="our-services-section dark-bg">
    <div class="container">
        <div class="text-center">
            <div class="title">
                {title && <h2>{title}</h2>}
                {subTitle && <h6>{subTitle}</h6>}
            </div>
            {services.length > 0 && (
            <div class="row our-services-content">
                {services.map(s => (
                <div class="col-lg-4 col-md-4 col-sm-12 col-12 item">
                    <a href={s.link ?? '#'} class="item-wrap">
                        {s.title && <h4>{s.title}</h4>}
                        {s.features && s.features.length > 0 && (
                        <ul class="p-0">
                            {s.features.map(f => f.text && <li>{f.text}</li>)}
                        </ul>
                        )}
                        <span class="light-page-link">
                            {s.linkLabel}
                        </span>
                    </a>
                </div>
                ))}
            </div>
            )}
        </div>
    </div>
</section>
