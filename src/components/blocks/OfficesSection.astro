            <polygon points="16.0,91.8 86.3,47.3 112.3,39.0 112.7,54.7 114.4,59.4 120.7,64.0 129.9,63.7 131.6,56.3 142.4,54.4 159.6,59.7 162.5,63.4 162.5,67.4 165.5,70.2 179.3,69.9 207.3,53.5 211.9,47.3 213.6,40.2 223.3,53.5 222.4,58.7 223.7,58.1 226.2,53.5 221.6,51.0 220.7,43.6 218.2,40.2 228.3,43.3 235.8,42.4 235.8,37.4 232.0,32.8 233.3,28.2 231.6,26.6 244.2,20.8 250.0,22.0 248.4,29.4 250.9,31.0 261.4,31.3 273.1,18.9 278.5,17.1 283.5,20.8 283.5,31.9 277.3,29.7 276.4,32.2 287.3,33.4 293.6,35.9 299.0,32.5 305.7,20.8 307.4,20.5 313.7,27.6 312.0,39.3 316.2,43.6 318.7,50.4 327.1,51.3 329.2,53.8 329.2,60.3 349.3,60.3 358.9,55.0 361.4,55.4 366.4,59.7 367.7,67.4 370.2,69.6 376.9,71.7 380.7,74.8 389.1,74.2 394.9,79.7 400.8,79.1 402.0,82.2 399.9,85.9 402.5,88.7 397.8,89.9 397.8,95.2 396.2,97.7 394.1,97.0 393.2,101.4 394.5,103.2 388.2,114.9 393.2,114.9 388.2,123.9 384.9,125.1 376.5,134.7 376.9,138.7 378.6,141.5 385.7,144.9 384.4,151.4 386.5,152.6 389.1,152.6 391.6,149.2 396.6,152.9 420.0,153.2 419.6,154.5 421.7,155.7 421.7,160.9 430.1,160.0 439.3,173.0 437.6,174.2 438.9,176.7 449.8,179.2 447.7,183.2 441.4,187.8 439.3,191.2 440.6,195.8 442.6,196.1 441.8,198.0 443.5,200.8 445.6,201.7 450.6,200.2 459.8,202.6 458.1,205.4 461.5,211.3 459.8,223.3 464.0,232.9 459.4,235.0 455.2,234.1 452.7,236.3 452.3,241.5 450.2,243.7 442.6,246.2 438.9,249.9 437.6,251.4 439.3,252.9 439.7,257.3 434.7,260.4 433.9,263.8 435.5,265.9 434.3,268.4 432.6,267.8 430.5,261.3 423.8,263.1 420.5,258.5 415.9,260.4 413.8,267.2 405.8,272.7 404.5,278.3 401.6,282.0 401.6,287.2 397.4,290.0 398.7,294.6 392.4,301.1 387.4,312.2 392.4,316.6 389.5,316.2 388.6,318.7 389.9,319.9 387.8,322.4 389.9,329.2 394.9,332.0 397.8,341.3 403.3,342.8 404.1,345.3 402.0,350.2 406.6,353.0 406.6,357.3 400.8,366.9 402.9,367.8 401.6,370.9 396.2,374.9 391.1,372.7 387.0,376.1 379.0,374.0 374.8,377.4 374.4,379.5 367.7,377.7 359.7,382.9 357.2,382.0 357.2,375.2 351.0,363.2 343.0,358.8 341.7,361.3 338.8,361.3 339.2,352.1 334.2,346.8 323.7,347.7 313.7,335.7 307.4,333.2 300.7,327.7 290.7,329.8 286.5,328.0 285.2,316.2 288.1,306.4 286.1,303.0 280.6,300.8 278.9,298.0 284.0,283.8 284.0,278.9 286.5,273.9 288.1,275.2 289.4,265.0 288.1,263.4 283.1,263.8 282.7,261.0 279.8,262.5 267.2,275.2 266.4,287.5 264.3,292.5 258.0,294.0 242.1,302.3 238.3,303.0 220.3,297.7 211.1,299.0 203.2,294.9 203.2,287.2 212.4,279.5 209.0,267.2 202.7,267.2 206.1,251.7 211.5,246.5 209.4,241.8 206.9,240.6 205.2,241.2 204.8,244.6 202.3,243.4 199.4,236.6 188.5,227.6 175.9,231.0 169.2,227.3 159.6,227.0 152.5,236.0 148.7,232.3 146.6,209.1 142.4,203.2 137.0,201.4 129.5,201.4 128.2,200.5 129.5,196.8 127.0,195.5 113.6,201.1 106.4,197.7 103.1,194.3 98.5,170.5 100.2,167.7 97.6,161.6 93.5,159.7 86.8,148.0 83.8,147.1 65.4,153.5 58.3,163.1 44.5,156.3 42.0,150.4 35.7,142.7 27.3,141.2 23.5,135.9 24.8,131.9 22.3,123.9 26.5,118.3 26.0,114.6 20.2,107.5 17.7,95.8" fill="url(#offices-dots)" stroke="#984895" stroke-opacity="0.7" stroke-width="1.2" stroke-linejoin="round"></polygon>
          </svg>

          {offices.filter(o => o.pinTop && o.pinLeft).map(o => (
            <div class="office-pin" data-pin={slug(o.city)} style={`left:${o.pinLeft}%; top:${o.pinTop}%`}>
              <span class="office-pin-marker" aria-hidden="true"></span>
              <span class="office-pin-label">{o.city}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
  </div>
</section>

<style>
  .offices-section {
    padding: 2.5rem 0 6rem;
    background: var(--offwhite);
    color: var(--ink);
  }
  .offices-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 4rem;
    align-items: center;
  }

  .offices-text { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; }
  .offices-eyebrow { margin: 0 0 0.6rem; font-family: var(--font-body); color: var(--violet); }
  .offices-heading { margin: 0 0 1.25rem; max-width: 560px; line-height: 1.2; }
  .offices-heading :global(em) { font-style: normal; color: var(--violet); }

  .offices-list { list-style: none; margin: 0.5rem 0 0; padding: 0; display: flex; flex-direction: column; }
  .office-row { border-top: 1px solid var(--border); }
  .office-row:last-child { border-bottom: 1px solid var(--border); }

  .office-row-link {
    display: flex; align-items: flex-start; gap: 1rem;
    padding: 1.25rem 1rem; margin: 0 -1rem; border-radius: 12px;
    color: inherit; text-decoration: none;
    transition: background-color 0.25s ease, box-shadow 0.25s ease;
  }
  .office-row-link:hover, .office-row-link:focus-visible, .office-row.is-active .office-row-link {
    background: var(--white); box-shadow: 0 4px 16px rgba(20,20,20,0.08);
  }

  .office-dot { flex: 0 0 auto; width: 10px; height: 10px; margin-top: 9px; border-radius: 999px; background: var(--violet); }
  .office-body { flex: 1 1 200px; min-width: 0; display: flex; flex-direction: column; gap: 0.25rem; }
  .office-city { margin: 0; font-family: var(--font-display); font-size: 1.2rem; font-weight: 500; color: var(--ink); }
  .office-address { margin: 0; font-size: 0.95rem !important; line-height: 1.5 !important; color: var(--muted); }

  .office-cta {
    flex: 0 0 auto; display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.85rem 0; font-family: var(--font-display); font-size: 0.8rem;
    font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--violet);
  }
  .office-row-link:hover .office-cta { color: var(--violet-light); }
  .office-cta svg { width: 14px; height: 14px; }

  .offices-map-col { flex: 1 1 420px; min-width: 0; display: flex; justify-content: center; }
  .offices-map { position: relative; width: 100%; max-width: 520px; padding: 1.5rem 0; }
  .offices-map-frame { position: relative; width: 100%; aspect-ratio: 480 / 400; }
  .offices-map-frame svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }

  .office-pin { position: absolute; transform: translate(-50%, -50%); display: flex; align-items: center; gap: 0.6rem; }
  .office-pin-marker {
    position: relative; width: 34px; height: 34px; border-radius: 999px;
    border: 1px solid var(--violet); display: flex; align-items: center; justify-content: center;
    opacity: 0.6; transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .office-pin-marker::after { content: ''; width: 12px; height: 12px; border-radius: 999px; background: var(--violet); }
  .office-pin.is-active .office-pin-marker { opacity: 1; transform: scale(1.4); animation: offices-pulse 1.4s ease-out infinite; }
  .office-pin-label { margin-left: -0.25rem; font-family: var(--font-display); font-size: 0.95rem; font-weight: 500; color: var(--ink); white-space: nowrap; }

  @keyframes offices-pulse {
    0% { box-shadow: 0 0 0 0 rgba(152,72,149,0.35); }
    100% { box-shadow: 0 0 0 14px rgba(152,72,149,0); }
  }

  @media (max-width: 900px) {
    .offices-section { padding: 2rem 0 4rem; }
    .office-row-link { flex-wrap: wrap; }
    .office-cta { padding-left: 1.6rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .office-pin.is-active .office-pin-marker { animation: none; }
  }
</style>

<script>
  // Hovering/focusing an office row highlights it and pulses the matching map pin.
  const sections = document.querySelectorAll<HTMLElement>('.offices-section');
  sections.forEach(section => {
    const rows = section.querySelectorAll<HTMLElement>('.office-row');
    const pins = section.querySelectorAll<HTMLElement>('.office-pin');

    function setActive(key: string | null) {
      rows.forEach(r => r.classList.toggle('is-active', r.dataset.office === key));
      pins.forEach(p => p.classList.toggle('is-active', p.dataset.pin === key));
    }

    rows.forEach(row => {
      const key = row.dataset.office ?? null;
      row.addEventListener('mouseenter', () => setActive(key));
      row.addEventListener('mouseleave', () => setActive(null));
      const link = row.querySelector<HTMLElement>('.office-row-link');
      link?.addEventListener('focus', () => setActive(key));
      link?.addEventListener('blur', () => setActive(null));
    });
  });
</script>
