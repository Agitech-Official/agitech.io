---
// New block: "Nos bureaux" — added when Agitech grew to 3 offices (BE).
// Locally scoped styles, reuses existing tokens only.
export interface Props {
  title?: string;
  subTitle?: string;
  mapLabel?: string;
  showMap?: boolean;
  offices?: { city?: string; address?: string }[];
}
const { title, subTitle, mapLabel = 'Voir sur la carte', showMap = false, offices = [] } = Astro.props;
---
<section class="offices-section" id="bureaux">
  <div class="container">
    <div class="offices-title">
      {title && <h3>{title}</h3>}
      {subTitle && <p>{subTitle}</p>}
    </div>
    {offices.length > 0 && (
      <div class={`offices-grid ${showMap ? 'has-map' : ''}`}>
        {offices.map(o => {
          const fullAddress = `${o.address}, ${o.city}`;
          const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;
          return (
            <div class="office-card">
              {showMap && (
                <div class="office-map-embed">
                  <iframe
                    src={`https://www.google.com/maps?q=${encodeURIComponent(fullAddress)}&output=embed`}
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title={`Kaart — ${o.city}`}
                  ></iframe>
                </div>
              )}
              {o.city && <h5>{o.city}</h5>}
              {o.address && <p>{o.address}</p>}
              <a class="office-map-link" href={mapsHref} target="_blank" rel="noopener">{mapLabel}</a>
            </div>
          );
        })}
      </div>
    )}
  </div>
</section>

<style>
  .offices-section {
    padding: 4rem 0;
    background: var(--offwhite, #f7f7f7);
  }
  .offices-title {
    max-width: 620px;
    margin: 0 auto 3rem;
    text-align: center;
  }
  .offices-title h3 {
    font-size: 1.9rem;
    margin-bottom: 0.75rem;
  }
  .offices-title p {
    color: var(--muted, #6b6b6b);
  }
  .offices-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .office-card {
    display: block;
    background: var(--white, #fff);
    border: 1px solid var(--border, #e5e5e5);
    border-radius: 16px;
    padding: 1.75rem;
    transition: border-color 0.25s, transform 0.25s;
  }
  .office-card:hover {
    border-color: var(--violet, #984895);
    transform: translateY(-4px);
  }
  .office-card h5 {
    font-size: 1.1rem;
    margin-bottom: 0.6rem;
  }
  .office-card p {
    color: var(--muted, #6b6b6b);
    font-size: 1.02rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }
  .office-map-link {
    display: inline-block;
    color: var(--violet, #984895);
    font-weight: 600;
    font-size: 0.98rem;
  }
  .office-map-embed {
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 1.25rem;
    aspect-ratio: 4 / 3;
  }
  .office-map-embed iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  @media (max-width: 900px) {
    .offices-grid { grid-template-columns: 1fr; }
  }
</style>
