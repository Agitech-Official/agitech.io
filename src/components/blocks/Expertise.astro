---
// Ported from template-parts/block/expertise.php
import { blockImg, blockAlt } from '../../lib/img';
export interface Props {
  bgClass?: string;
  customList?: boolean;
  title?: string;
  description?: string;
  expertise?: { icon?: string; heading?: string; subHeading?: string; description?: string }[];
}
const { bgClass = '', customList = false, title, description, expertise = [] } = Astro.props;
---
<section class={`expertises-section ${customList ? 'custom-list' : ''} ${bgClass}`}>
  <div class="container">
    <div class="row">
      {title && (
        <div class="col-lg-4 col-md-12 col-sm-6 col-12 title">
          <h3>{title}</h3>
        </div>
      )}
      <div class="col-lg-8 col-md-12 col-sm-6 col-12 content">
        {description && (
          <div class="row"><div class="col-12 para-text"><h6 set:html={description} /></div></div>
        )}
        {expertise.length > 0 && (
          <div class="row">
            {expertise.map(e => (
              <div class="col-lg-6 col-md-6 col-sm-12 col-12 expertises-content">
                <div class="item">
                  {e.icon && <div class="icon"><img src={blockImg(e.icon)} alt={blockAlt(e.icon)}></div>}
                  {e.heading && <h5>{e.heading}</h5>}
                  {e.subHeading && <p>{e.subHeading}</p>}
                  {e.description && <Fragment set:html={e.description} />}
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</section>
