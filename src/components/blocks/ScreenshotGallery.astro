---
// Product screenshots: first shot full width, the rest side by side. Click opens the full image.
import { blockImg } from '../../lib/img';
export interface Props {
  title?: string;
  intro?: string;
  shots?: { image?: string; caption?: string }[];
}
const { title, intro, shots = [] } = Astro.props;
const [first, ...rest] = shots;
---
<section class="shots-section">
  <div class="container">
    {title && <h2>{title}</h2>}
    {intro && <p class="shots-intro">{intro}</p>}
    {first?.image && (
      <figure class="shot shot-main">
        <a href={blockImg(first.image)} target="_blank" rel="noopener"><img src={blockImg(first.image)} alt={first.caption ?? ''} loading="lazy"></a>
        {first.caption && <figcaption>{first.caption}</figcaption>}
      </figure>
    )}
    {rest.length > 0 && (
      <div class="shots-row">
        {rest.map(s => s.image && (
          <figure class="shot">
            <a href={blockImg(s.image)} target="_blank" rel="noopener"><img src={blockImg(s.image)} alt={s.caption ?? ''} loading="lazy"></a>
            {s.caption && <figcaption>{s.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .shots-section { padding: 4rem 0; }
  .shots-section h2 { font-size: clamp(1.5rem, 3vw, 1.9rem); margin-bottom: 0.75rem; }
  .shots-intro { color: var(--muted, #6b6b6b); max-width: 640px; margin-bottom: 2rem; }
  .shot { margin: 0; }
  .shot img { width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--border, #e5e5e5); box-shadow: 0 10px 30px rgba(0,0,0,0.08); background: #fff; transition: transform 0.3s, box-shadow 0.3s; }
  .shot a:hover img { transform: translateY(-3px); box-shadow: 0 16px 40px rgba(0,0,0,0.14); }
  .shot figcaption { margin-top: 0.75rem; font-size: 0.88rem; color: var(--muted, #6b6b6b); }
  .shot-main { margin-bottom: 1.75rem; }
  /* A lone screenshot (no row below) is capped so small captures aren't blown up. */
  .shot-main:last-child { margin-bottom: 0; }
  .shot-main:last-child img { max-width: 900px; }
  .shots-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem; }
  @media (max-width: 800px) { .shots-row { grid-template-columns: 1fr; } }
</style>
