---
// Homepage section: "Ce qu'on développe, et comment on le facture" — new for the
// développement-au-forfait brief. Not ported from WP, built fresh. Locally scoped
// styles only (no changes to public/assets/style.css), reuses existing CSS tokens.
//
// UI/UX pass: the first version stacked 6 separate blocks (title, cards, tech
// badges, explainer paragraph, tags line, CTAs, plus a boxed "DIY" callout) —
// too many competing pieces for a homepage teaser. Collapsed to 3: header,
// cards (the actual value props), and one footer row (compact tech mention +
// CTAs + a plain-text DIY link instead of its own bordered box). Depth lives
// on the dedicated page, not here.
import Cta from './Cta.astro';
export interface Props {
  title?: string;
  intro?: string;
  cards?: { title?: string; text?: string; featured?: boolean }[];
  ctaPrimary?: { label?: string; url?: string };
  ctaSecondary?: { label?: string; url?: string };
  diyTitle?: string;
  diyCta?: { label?: string; url?: string };
}
const { title, intro, cards = [], ctaPrimary, ctaSecondary, diyTitle, diyCta } = Astro.props;
const ICONS = 'https://cdn.jsdelivr.net/npm/@lobehub/icons-static-svg@1/icons';
const STACK = [
  { label: 'GPT', logo: `${ICONS}/openai.svg` },
  { label: 'Claude', logo: `${ICONS}/claude-color.svg` },
  { label: 'Odoo', logo: '/assets/img/blocks/LogoOdoo.svg', wide: true },
];
---
<section class="forfait-home">
  <div class="container">
    <div class="forfait-home-title">
      {title && <h2>{title}</h2>}
      {intro && <p>{intro}</p>}
    </div>
    {cards.length > 0 && (
      <div class="forfait-cards">
        {cards.map(c => (
          <div class={`forfait-card ${c.featured ? 'is-featured' : ''}`}>
            {c.title && <h3>{c.title}</h3>}
            {c.text && <p>{c.text}</p>}
          </div>
        ))}
      </div>
    )}
    <div class="forfait-footer">
      <div class="forfait-stack" aria-label="GPT, Claude, Odoo">
        {STACK.map(s => (
          <img src={s.logo} alt={s.label} class={s.wide ? 'is-wide' : ''} loading="lazy" />
        ))}
      </div>
      {(ctaPrimary?.label || ctaSecondary?.label) && (
        <div class="forfait-ctas">
          <Cta label={ctaPrimary?.label} url={ctaPrimary?.url} wrapClass="primary-btn" />
          <Cta label={ctaSecondary?.label} url={ctaSecondary?.url} wrapClass="forfait-outline-btn" />
        </div>
      )}
      {diyTitle && diyCta?.url && (
        <a href={diyCta.url} class="forfait-diy-link">{diyTitle} {diyCta.label} →</a>
      )}
    </div>
  </div>
</section>

<style>
  .forfait-home {
    padding: 2.5rem 0;
    background: var(--offwhite, #f7f7f7);
  }
  .forfait-home-title {
    max-width: 640px;
    margin: 0 auto 1.25rem;
    text-align: center;
  }
  .forfait-home-title h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.75rem);
    margin-bottom: 0.35rem;
  }
  .forfait-home-title p {
    color: var(--muted, #6b6b6b);
    font-size: 0.95rem;
  }
  .forfait-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .forfait-card {
    background: var(--white, #fff);
    border: 1px solid var(--border, #e5e5e5);
    border-radius: 12px;
    padding: 0.9rem 1rem;
  }
  .forfait-card {
    transition: border-color 0.25s, box-shadow 0.25s;
  }
  .forfait-card:hover {
    border-color: var(--violet, #984895);
    box-shadow: 0 0 0 1px var(--violet, #984895);
  }
  .forfait-card h3 {
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }
  .forfait-card p {
    font-size: 0.82rem;
    color: var(--muted, #6b6b6b);
    line-height: 1.4;
    margin: 0;
  }
  .forfait-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .forfait-stack {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
    opacity: 0.85;
  }
  .forfait-stack img { height: 1.3rem; width: auto; }
  .forfait-ctas {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .forfait-home :global(.forfait-outline-btn a) {
    display: inline-block;
    border: 1px solid var(--violet, #984895);
    color: var(--violet, #984895);
    background: transparent;
    padding: 0.85rem 1.8rem;
    border-radius: 100px;
    font-size: 0.95rem;
    font-weight: 500;
    transition: background 0.2s, color 0.2s;
  }
  .forfait-home :global(.forfait-outline-btn a:hover) {
    background: var(--violet, #984895);
    color: var(--white, #fff);
  }
  .forfait-diy-link {
    font-size: 0.85rem;
    color: var(--muted, #6b6b6b);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .forfait-diy-link:hover { color: var(--violet, #984895); }
</style>
