---
// Homepage AI / fixed-price teaser. Layout borrowed from the original agitech.io
// "why" sections: dark band, violet eyebrow + large light title on the left, numbered
// rows separated by thin rules on the right. One idea per row, nothing boxed.
import Cta from './Cta.astro';
export interface Props {
  title?: string;
  eyebrow?: string;
  cards?: { title?: string; text?: string; featured?: boolean }[];
  ctaPrimary?: { label?: string; url?: string };
  ctaSecondary?: { label?: string; url?: string };
  diyTitle?: string;
  diyCta?: { label?: string; url?: string };
}
const { title, eyebrow, cards = [], ctaPrimary, ctaSecondary, diyTitle, diyCta } = Astro.props;
const ICONS = 'https://cdn.jsdelivr.net/npm/@lobehub/icons-static-svg@1/icons';
const STACK = [
  { label: 'GPT', logo: `${ICONS}/openai.svg`, invert: true },
  { label: 'Claude', logo: `${ICONS}/claude-color.svg` },
  { label: 'Odoo', logo: '/assets/img/blocks/LogoOdoo.svg', wide: true, invert: true },
];
---
<section class="forfait-home dark-bg">
  <div class="container">
    <div class="forfait-grid">
      <div class="forfait-left">
        {eyebrow && <h6>{eyebrow}</h6>}
        {title && <h2>{title}</h2>}
        <div class="forfait-stack" aria-label="GPT, Claude, Odoo">
          {STACK.map(s => (
            <img src={s.logo} alt={s.label} class={`${s.wide ? 'is-wide' : ''} ${s.invert ? 'is-invert' : ''}`} loading="lazy" />
          ))}
        </div>
        {(ctaPrimary?.label || ctaSecondary?.label) && (
          <div class="forfait-ctas">
            <Cta label={ctaPrimary?.label} url={ctaPrimary?.url} wrapClass="primary-btn" />
            <Cta label={ctaSecondary?.label} url={ctaSecondary?.url} wrapClass="light-btn" />
          </div>
        )}
      </div>
      <div class="forfait-right">
        {cards.map((c, i) => (
          <div class="forfait-row">
            <span class="forfait-num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              {c.title && <h4>{c.title}</h4>}
              {c.text && <p>{c.text}</p>}
            </div>
          </div>
        ))}
        {diyTitle && diyCta?.url && (
          <a href={diyCta.url} class="forfait-diy-link">{diyTitle} {diyCta.label} →</a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .forfait-home { padding: 4rem 0; background: var(--black, #1d1d1d); color: var(--white, #fff); }
  .forfait-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .forfait-left h6 { color: var(--violet-light, #b671b3); font-family: var(--font-body); font-size: 1.05rem; font-weight: 400; letter-spacing: 0.02em; margin-bottom: 0.75rem; }
  .forfait-left h2 { color: var(--white, #fff); font-size: clamp(1.7rem, 1.1rem + 2vw, 2.6rem); line-height: 1.2; margin-bottom: 1.75rem; }
  .forfait-stack { display: flex; align-items: center; gap: 1.25rem; margin-bottom: 2rem; opacity: 0.9; }
  .forfait-stack img { height: 1.5rem; width: auto; }
  .forfait-stack img.is-invert { filter: brightness(0) invert(1); }
  .forfait-ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .forfait-right { border-top: 1px solid var(--border-onDark, rgba(255,255,255,0.1)); }
  .forfait-row { display: flex; gap: 1.5rem; align-items: baseline; padding: 1.4rem 0; border-bottom: 1px solid var(--border-onDark, rgba(255,255,255,0.1)); }
  .forfait-num { flex: 0 0 auto; color: var(--violet-light, #b671b3); font-size: 0.9rem; font-weight: 600; }
  .forfait-row h4 { color: var(--white, #fff); font-size: 1.3rem; margin: 0 0 0.3rem; }
  .forfait-row p { color: var(--muted-onDark, #b7b0c2); font-size: 0.95rem; margin: 0; }
  .forfait-diy-link { display: inline-block; margin-top: 1.25rem; font-size: 0.88rem; color: var(--muted-onDark, #b7b0c2); text-decoration: underline; text-underline-offset: 3px; }
  .forfait-diy-link:hover { color: var(--white, #fff); }
  @media (max-width: 900px) { .forfait-grid { grid-template-columns: 1fr; gap: 2.5rem; } }
</style>
