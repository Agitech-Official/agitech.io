---
// Homepage section: "Ce qu'on développe, et comment on le facture" — new for the
// développement-au-forfait brief. Not ported from WP, built fresh. Locally scoped
// styles only (no changes to public/assets/style.css), reuses existing CSS tokens.
import Cta from './Cta.astro';
export interface Props {
  title?: string;
  intro?: string;
  cards?: { title?: string; text?: string; featured?: boolean }[];
  tagsTitle?: string;
  tags?: string[];
  explainerText?: string;
  ctaPrimary?: { label?: string; url?: string };
  ctaSecondary?: { label?: string; url?: string };
  diyTitle?: string;
  diyText?: string;
  diyCta?: { label?: string; url?: string };
}
const { title, intro, cards = [], tagsTitle, tags = [], explainerText, ctaPrimary, ctaSecondary, diyTitle, diyText, diyCta } = Astro.props;
const ICONS = 'https://cdn.jsdelivr.net/npm/@lobehub/icons-static-svg@1/icons';
const STACK = [
  { label: 'GPT Astra', logo: `${ICONS}/openai.svg` },
  { label: 'Claude Fable', logo: `${ICONS}/claude-color.svg` },
  { label: 'Odoo', logo: '/assets/img/site/LogoOdoo.svg', wide: true },
];
---
<section class="forfait-home">
  <div class="container">
    <div class="forfait-home-title">
      {title && <h2>{title}</h2>}
      {intro && <p>{intro}</p>}
    </div>
    {cards.length > 0 && (
      <div class="forfait-cards">
        {cards.map(c => (
          <div class={`forfait-card ${c.featured ? 'is-featured' : ''}`}>
            {c.title && <h3>{c.title}</h3>}
            {c.text && <p>{c.text}</p>}
          </div>
        ))}
      </div>
    )}
    <div class="forfait-stack">
      <span class="forfait-stack-title">{tagsTitle || 'Notre combo technique'}</span>
      {STACK.map(s => (
        <span class="forfait-stack-item">
          <img src={s.logo} alt="" class={s.wide ? 'is-wide' : ''} loading="lazy" />
          {!s.wide && s.label}
          {s.wide && <span class="sr-only">{s.label}</span>}
        </span>
      ))}
    </div>
    {(explainerText || tags.length > 0) && (
      <p class="forfait-explainer">
        {explainerText}
        {tags.length > 0 && <span class="forfait-stack-note">{tags.join(' · ')}</span>}
      </p>
    )}
    {(ctaPrimary?.label || ctaSecondary?.label) && (
      <div class="forfait-ctas">
        <Cta label={ctaPrimary?.label} url={ctaPrimary?.url} wrapClass="primary-btn" />
        <Cta label={ctaSecondary?.label} url={ctaSecondary?.url} wrapClass="forfait-outline-btn" />
      </div>
    )}
    {diyTitle && (
      <div class="forfait-diy">
        <div>
          <strong>{diyTitle}</strong>
          {diyText && <span>{diyText}</span>}
        </div>
        <Cta label={diyCta?.label} url={diyCta?.url} wrapClass="forfait-outline-btn" />
      </div>
    )}
  </div>
</section>

<style>
  .forfait-home {
    padding: 2.5rem 0;
    background: var(--offwhite, #f7f7f7);
  }
  .forfait-home-title {
    max-width: 640px;
    margin: 0 auto 1.25rem;
    text-align: center;
  }
  .forfait-home-title h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.75rem);
    margin-bottom: 0.35rem;
  }
  .forfait-home-title p {
    color: var(--muted, #6b6b6b);
    font-size: 0.95rem;
  }
  .forfait-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .forfait-card {
    background: var(--white, #fff);
    border: 1px solid var(--border, #e5e5e5);
    border-radius: 12px;
    padding: 0.9rem 1rem;
  }
  .forfait-card.is-featured {
    border-color: var(--violet, #984895);
    box-shadow: 0 0 0 1px var(--violet, #984895);
  }
  .forfait-card h3 {
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }
  .forfait-card p {
    font-size: 0.82rem;
    color: var(--muted, #6b6b6b);
    line-height: 1.4;
    margin: 0;
  }
  .forfait-stack {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 0.75rem;
    margin-bottom: 0.6rem;
  }
  .forfait-stack-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--violet, #984895);
  }
  .forfait-stack-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2.1rem;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0 0.9rem;
    border-radius: 100px;
    border: 1px solid var(--border, #e5e5e5);
    background: var(--white, #fff);
    color: var(--ink, #1d1d1d);
  }
  .forfait-stack-item img { width: 1.15rem; height: 1.15rem; }
  .forfait-stack-item img.is-wide { width: auto; height: 1rem; }
  .forfait-explainer {
    max-width: 720px;
    margin: 0 auto 1.1rem;
    text-align: center;
    color: var(--muted, #6b6b6b);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .forfait-stack-note {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.78rem;
  }
  .forfait-ctas {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .forfait-home :global(.forfait-outline-btn a) {
    display: inline-block;
    border: 1px solid var(--violet, #984895);
    color: var(--violet, #984895);
    background: transparent;
    padding: 0.85rem 1.8rem;
    border-radius: 100px;
    font-size: 0.95rem;
    font-weight: 500;
    transition: background 0.2s, color 0.2s;
  }
  .forfait-home :global(.forfait-outline-btn a:hover) {
    background: var(--violet, #984895);
    color: var(--white, #fff);
  }
  .forfait-diy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 860px;
    margin: 1.5rem auto 0;
    padding: 0.9rem 1.25rem;
    border: 1px dashed var(--violet, #984895);
    border-radius: 12px;
    background: var(--white, #fff);
  }
  .forfait-diy strong { display: block; font-size: 1rem; color: var(--ink, #1d1d1d); }
  .forfait-diy span { font-size: 0.85rem; color: var(--muted, #6b6b6b); }
  .forfait-diy :global(.forfait-outline-btn a) { padding: 0.55rem 1.2rem; font-size: 0.85rem; white-space: nowrap; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
  }
  @media (max-width: 560px) {
    .forfait-diy { flex-direction: column; text-align: center; }
  }
</style>
