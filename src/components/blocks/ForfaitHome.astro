---
// Homepage AI / fixed-price teaser. Layout borrowed from the original agitech.io
// "why" sections: violet eyebrow + large light title on the left, numbered rows
// separated by thin rules on the right. Light background so it never sits dark-on-dark
// against the hero. One idea per row, nothing boxed.
import Cta from './Cta.astro';
export interface Props {
  title?: string;
  eyebrow?: string;
  cards?: { title?: string; text?: string; featured?: boolean }[];
  ctaPrimary?: { label?: string; url?: string };
  ctaSecondary?: { label?: string; url?: string };
  diyTitle?: string;
  diyCta?: { label?: string; url?: string };
}
const { title, eyebrow, cards = [], ctaPrimary, ctaSecondary, diyTitle, diyCta } = Astro.props;
const STACK = [
  { label: 'ChatGPT', logo: '/assets/img/blocks/ai-openai.svg' },
  { label: 'Claude', logo: '/assets/img/blocks/ai-claude.svg' },
  { label: 'Odoo', logo: '/assets/img/blocks/LogoOdoo.svg', wide: true },
];
---
<section class="forfait-home">
  <div class="container">
    <div class="forfait-grid">
      <div class="forfait-left">
        {eyebrow && <h6>{eyebrow}</h6>}
        {title && <h2>{title}</h2>}
        <div class="forfait-stack" aria-label="GPT, Claude, Odoo">
          {STACK.map(s => (
            <span class="forfait-chip">
              <img src={s.logo} alt={s.wide ? s.label : ''} class={s.wide ? 'is-wide' : ''} loading="lazy" />
              {!s.wide && <span>{s.label}</span>}
            </span>
          ))}
        </div>
        {(ctaPrimary?.label || ctaSecondary?.label) && (
          <div class="forfait-ctas">
            <Cta label={ctaPrimary?.label} url={ctaPrimary?.url} wrapClass="primary-btn" />
            <Cta label={ctaSecondary?.label} url={ctaSecondary?.url} wrapClass="forfait-outline-btn" />
          </div>
        )}
      </div>
      <div class="forfait-right">
        {cards.map((c, i) => (
          <div class="forfait-row">
            <span class="forfait-num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              {c.title && <h4>{c.title}</h4>}
              {c.text && <p>{c.text}</p>}
            </div>
          </div>
        ))}
        {diyTitle && diyCta?.url && (
          <a href={diyCta.url} class="forfait-diy-link">{diyTitle} {diyCta.label} →</a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .forfait-home { padding: 4rem 0; background: var(--offwhite, #f7f7f7); color: var(--ink, #16151a); }
  .forfait-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .forfait-left h6 { color: var(--violet, #984895); font-family: var(--font-body); font-size: 1.05rem; font-weight: 400; letter-spacing: 0.02em; margin-bottom: 0.75rem; }
  .forfait-left h2 { color: var(--ink, #16151a); font-size: clamp(1.7rem, 1.1rem + 2vw, 2.6rem); line-height: 1.2; margin-bottom: 1.75rem; }
  .forfait-stack { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-bottom: 2rem; }
  .forfait-chip { display: inline-flex; align-items: center; gap: 0.6rem; height: 3rem; padding: 0 1.1rem; background: var(--white, #fff); border: 1px solid var(--border, rgba(20,20,20,0.09)); border-radius: 100px; font-size: 1.05rem; font-weight: 500; color: var(--ink, #16151a); }
  .forfait-chip img { height: 1.6rem; width: 1.6rem; }
  .forfait-chip img.is-wide { width: auto; height: 1.3rem; }
    .forfait-home :global(.forfait-outline-btn a) { display: inline-block; border: 1px solid var(--violet, #984895); color: var(--violet, #984895); padding: 0.85rem 1.8rem; border-radius: 100px; font-size: 1.05rem; font-weight: 500; transition: background 0.2s, color 0.2s; }
  .forfait-home :global(.forfait-outline-btn a:hover) { background: var(--violet, #984895); color: var(--white, #fff); }
  .forfait-ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .forfait-right { border-top: 1px solid var(--border, rgba(20,20,20,0.09)); }
  .forfait-row { display: flex; gap: 1.5rem; align-items: baseline; padding: 1.4rem 0; border-bottom: 1px solid var(--border, rgba(20,20,20,0.09)); }
  .forfait-num { flex: 0 0 auto; color: var(--violet, #984895); font-size: 1.0rem; font-weight: 600; }
  .forfait-row h4 { color: var(--ink, #16151a); font-size: 1.3rem; margin: 0 0 0.3rem; }
  .forfait-row p { color: var(--muted, #6b6b76); font-size: 1.05rem; margin: 0; }
  .forfait-diy-link { display: inline-block; margin-top: 1.25rem; font-size: 0.98rem; color: var(--muted, #6b6b76); text-decoration: underline; text-underline-offset: 3px; }
  .forfait-diy-link:hover { color: var(--violet, #984895); }
  @media (max-width: 900px) { .forfait-grid { grid-template-columns: 1fr; gap: 2.5rem; } }
</style>
