---
// Ported from template-parts/block/help-block.php (the CTA wrapper is always rendered, like in WP)
export interface Props {
  bgClass?: string;
  title?: string;
  headingTitle?: string;
  cards?: { title?: string; subTitle?: string; link?: string; linkLabel?: string; newTab?: boolean; calendly?: boolean }[];
  cta?: { label?: string; url?: string; newTab?: boolean; calendly?: boolean };
}
const { bgClass = '', title, headingTitle, cards = [], cta } = Astro.props;
---
<section class={`help-section ${bgClass}`} id="help-section">
  <div class="container">
    {title && <h6>{title}</h6>}
    {headingTitle && <h3>{headingTitle}</h3>}
    {cards.length > 0 && (
      <div class="row help-fields">
        {cards.map(card => (
          <div class="col-lg-3 col-md-6 field">
            <a href={card.link ?? '#'} class="service-card" target={card.newTab ? '_blank' : undefined} rel={card.newTab ? 'noopener' : undefined}>
              {card.title && <h5 set:html={card.title} />}
              {card.subTitle && <p>{card.subTitle}</p>}
              <span class="page-link">{card.linkLabel}</span>
            </a>
          </div>
        ))}
        <div class="primary-btn">
          {cta?.label && cta?.url && (cta.calendly
            ? <a href="#" data-calendly-url={cta.url}>{cta.label}</a>
            : <a href={cta.url} target={cta.newTab ? '_blank' : undefined} rel={cta.newTab ? 'noopener' : undefined}>{cta.label}</a>)}
        </div>
      </div>
    )}
  </div>
</section>
