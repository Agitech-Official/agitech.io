---
// Home: our clients split by size (MMC = mid-market corporate, PME). A tile shows the client's logo
// when we have one, its name otherwise; it links to the case study when there is one.
import { blockImg } from '../../lib/img';
type Client = { name: string; logo?: string; href?: string };
type Segment = { label?: string; name?: string; description?: string; clients?: Client[] };
export interface Props {
  title?: string;
  subTitle?: string;
  segments?: Segment[];
}
const { title, subTitle, segments = [] } = Astro.props;
---
<section class="segments-section">
  <div class="container">
    <div class="segments-head">
      {title && <h6>{title}</h6>}
      {subTitle && <h3>{subTitle}</h3>}
    </div>
    <div class="segments-grid">
      {segments.map(s => (
        <div class="segment">
          <div class="segment-top">
            {s.label && <span class="segment-label">{s.label}</span>}
            {s.name && <h4>{s.name}</h4>}
            {s.description && <p>{s.description}</p>}
          </div>
          <ul class="clients">
            {(s.clients ?? []).map(c => {
              const inner = c.logo
                ? <img src={blockImg(c.logo)} alt={c.name} loading="lazy">
                : <span class="client-name">{c.name}</span>;
              return <li>{c.href ? <a href={c.href} aria-label={c.name}>{inner}</a> : <div>{inner}</div>}</li>;
            })}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Corporate look: flat, hairlines instead of cards/shadows, small radii, muted logos. */
  .segments-section { padding: 5rem 0; background: #fff; border-top: 1px solid var(--border, rgba(20,20,20,0.09)); }
  .segments-head { max-width: 720px; margin-bottom: 3rem; }
  .segments-head h6 { color: var(--muted, #6b6b76); text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.78rem; font-weight: 600; margin-bottom: 0.8rem; }
  .segments-head h3 { font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.3rem); line-height: 1.2; margin: 0; }
  .segments-grid { display: grid; grid-template-columns: 5fr 7fr; gap: 3.5rem; }
  .segment { border-top: 2px solid var(--ink, #16151a); padding-top: 1.5rem; display: flex; flex-direction: column; gap: 1.75rem; }
  .segment-label { display: block; color: var(--violet, #984895); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 0.6rem; }
  .segment-top h4 { font-size: 1.35rem; margin: 0 0 0.5rem; }
  .segment-top p { color: var(--muted, #6b6b76); margin: 0; font-size: 0.97rem; }
  .clients { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 1px; background: var(--border, rgba(20,20,20,0.09)); border: 1px solid var(--border, rgba(20,20,20,0.09)); }
  .clients li { background: #fff; }
  .clients li > a, .clients li > div { display: flex; align-items: center; justify-content: center; height: 96px; padding: 1rem 1.25rem; text-decoration: none; color: var(--ink, #16151a); transition: background 0.2s; }
  .clients li > a:hover { background: var(--offwhite, #f7f7f7); }
  .clients img { max-width: 100%; max-height: 44px; object-fit: contain; filter: grayscale(1); opacity: 0.8; transition: opacity 0.2s; }
  .clients a:hover img { opacity: 1; }
  .client-name { font-weight: 600; font-size: 1.05rem; letter-spacing: 0.02em; text-align: center; color: #3a3a44; }
  @media (max-width: 900px) { .segments-grid { grid-template-columns: 1fr; gap: 2.5rem; } .segments-section { padding: 3.5rem 0; } }
</style>
