---
// Ported from template-parts/block/talk-to-us.php ("Credited Assistant Block")
import Cta from './Cta.astro';
import { blockImg } from '../../lib/img';
export interface Props {
  bgClass?: string;
  image?: string;
  title?: string;
  subTitle?: string;
  contentDetails?: string;
  cta?: { label?: string; url?: string; newTab?: boolean };
}
const { bgClass = '', image, title, subTitle, contentDetails, cta } = Astro.props;
---
<section class={`talk-section ${bgClass}`}>
  <div class="container-sm">
    <div class="row">
      <div class="col-lg-6 col-md-6 col-sm-12 col-12">
        <div class="person-img">
          {image && <img src={blockImg(image)} alt={title ?? ''}>}
        </div>
      </div>
      <div class="col-lg-6 col-md-6 col-sm-12 col-12">
        <div class="content">
          {title && <h6>{title}</h6>}
          {subTitle && <h4>{subTitle}</h4>}
          {contentDetails && <Fragment set:html={contentDetails} />}
          {cta && <Cta label={cta.label} url={cta.url} newTab={cta.newTab} />}
        </div>
      </div>
    </div>
  </div>
</section>
