    challenge: '<ul><li><strong>Facturation avec Excel et Expensify :</strong> aucune centralisation, méconnaissance d’Odoo</li><li><strong>Processus de réconciliation bancaire :</strong> gestion de la réconciliation manuellement sur Excel</li><li><strong>Gestion des RH et des congés inefficace :</strong> échange d’emails et suivi des congés avec le calendrier Outlook et Excel</li></ul><img class="alignnone wp-image-1382 size-full" src="/wp-content/uploads/2025/05/image.png" alt="romaforeurope" width="1128" height="191" srcset="/wp-content/uploads/2025/05/image.png 1128w, /wp-content/uploads/2025/05/image-300x51.png 300w, /wp-content/uploads/2025/05/image-1024x173.png 1024w, /wp-content/uploads/2025/05/image-768x130.png 768w" sizes="(max-width: 1128px) 100vw, 1128px">'
