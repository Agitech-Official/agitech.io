---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import InnerHero from '../../../components/blocks/InnerHero.astro';
import TalkToUs from '../../../components/blocks/TalkToUs.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const slugs = await reader.collections.blog.list();
const posts = (
  await Promise.all(slugs.map(async (slug) => ({ slug, entry: await reader.collections.blog.read(slug) })))
)
  .filter(({ entry }) => entry && entry.lang === 'en')
  .sort((a, b) => (b.entry.publishedAt ?? '').localeCompare(a.entry.publishedAt ?? ''));
---
<Layout
  lang="en"
  title="Odoo & ERP Blog: Guides and Insights | Agitech"
  description="Practical guides on Odoo, choosing an ERP, budgeting, migration and project governance. Field insights from a Belgian Odoo partner."
  canonical="https://agitech.io/en/blog/"
>
  <Header slot="header" lang="en" />
  <main>
    <InnerHero title="The Agitech Blog" subTitle="Our thinking, our methods, our field notes." bottomLine={true} />
    <section class="blog-listing-section lighter-gray-bg">
      <div class="container">
        <div class="row items-wrap blog-wrap">
          {posts.map(({ slug, entry }) => (
            <div class="item">
              <a href={`/en/${slug}/`}>
                <div class="field">
                  <div class="content">
                    {entry.category && <div class="case_types"><span class="green-text">{entry.category}</span></div>}
                    <h6>{entry.title}</h6>
                    {entry.excerpt && <p>{entry.excerpt}</p>}
                    {entry.publishedAt && <span class="post-date">{entry.publishedAt}</span>}
                  </div>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
    <TalkToUs
      bgClass="white-bg"
      image="sam-profile.jpg"
      title="Talk about your project with Sam"
      subTitle="No sales rep at Agitech, we talk directly, business owner to business owner."
      contentDetails="<p>Need a straight answer, a quick budget estimate? You can book a video call with me directly via the link below.</p><p>If your request is urgent, you can email me directly at: Sam (at) agitech.io</p>"
      cta={{ label: 'Talk to Sam', url: '/en/contact-us/' }}
    />
  </main>
  <Footer slot="footer" lang="en" />
</Layout>
