---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import BlockRenderer from '../../../components/BlockRenderer.astro';
import { casePaths } from '../../../lib/content';
import { caseSeo, headingOf } from '../../../lib/seo';

export async function getStaticPaths() {
  return casePaths('en');
}

const { entry } = Astro.props;
const seo = caseSeo(entry);
---
<Layout
  lang="en"
  bodyClass="single single-business-cases"
  {...seo}
  title={entry.seoTitle || entry.title}
  description={entry.seoDescription ?? ''}
>
  <Header slot="header" lang="en" />
  <main>
    <h1 class="visually-hidden-h1">{headingOf(entry)}</h1>
    <BlockRenderer blocks={entry.blocks} /></main>
  <Footer slot="footer" lang="en" />
</Layout>
