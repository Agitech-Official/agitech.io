---
// EN mirror of business-cases/index.astro.
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FeaturedCases from '../../../components/blocks/FeaturedCases.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const slugs = await reader.collections.businessCases.list();
const entries = await Promise.all(
  slugs.map(async (slug) => ({ slug, entry: await reader.collections.businessCases.read(slug) }))
);
const cases = entries
  .filter(({ entry }) => entry && entry.lang === 'en')
  .map(({ slug, entry }) => ({
    title: entry!.title,
    href: `/en/business-cases/${slug.replace(/-en$/, '')}/`,
    image: entry!.coverImage ?? undefined,
    caseType: entry!.industry ?? undefined,
  }));
---
<Layout
  lang="en"
  title="Odoo Case Studies: Belgian SME Projects | Agitech"
  description="RomaForEurope, Fernatech, Lastlink, FreeMoov… see how Agitech delivered Odoo for Belgian SMEs: accounting, e-commerce, CRM and custom development."
  canonical="https://agitech.io/en/business-cases/"
>
  <Header slot="header" lang="en" />
  <main>
    <section class="banner-sec inner-pages-banner dark-bg">
      <div class="container">
        <div class="row">
          <div class="col-lg-12 col-md-12 col-sm-12 col-12">
            <div class="text">
              <h6>Our work</h6>
              <h1>Case Studies</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <FeaturedCases cases={cases} />
  </main>
  <Footer slot="footer" lang="en" />
</Layout>
