---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import InnerHero from '../../components/blocks/InnerHero.astro';
import TalkToUs from '../../components/blocks/TalkToUs.astro';
import { blockImg } from '../../lib/img';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const slugs = await reader.collections.businessCases.list();
const cases = (
  await Promise.all(slugs.map(async (slug) => ({ slug, entry: await reader.collections.businessCases.read(slug) })))
).filter(({ entry }) => entry && entry.lang === 'en');
---
<Layout
  lang="en"
  title="Our results — Agitech"
  description="Join 92 companies who trust us. Discover our Odoo business cases."
  canonical="https://agitech.io/en/case-study/"
>
  <Header slot="header" lang="en" />
  <main>
    <InnerHero title="We measure our success by results" subTitle="Join 92 companies who trust us" bottomLine={true} />
    <section class="we-implemented-section lighter-gray-bg">
      <div class="container">
        <div class="row items-wrap">
          {cases.map(({ slug, entry }) => (
            <div class="item">
              <a href={`/en/business-cases/${slug.replace(/-en$/, '')}/`}>
                <div class="field">
                  <div class="img">{entry.coverImage && <img src={blockImg(entry.coverImage)} alt={entry.title}>}</div>
                  <div class="content">
                    {entry.industry && <div class="case_types"><span class="green-text">{entry.industry}</span></div>}
                    <h6>{entry.client || entry.title}</h6>
                  </div>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
    <TalkToUs
      bgClass="white-bg"
      image="sam-profile.jpg"
      title="Talk about your project with Sam"
      subTitle="No sales rep at Agitech, we talk directly, business owner to business owner."
      contentDetails="<p>Need a straight answer, a quick budget estimate? You can book a video call with me directly via the link below.</p><p>If your request is urgent, you can email me directly at: Sam (at) agitech.io</p>"
      cta={{ label: 'Talk to Sam', url: '/en/contact-us/' }}
    />
  </main>
  <Footer slot="footer" lang="en" />
</Layout>
