---
// Business cases listing — reads the businessCases collection directly (not a
// Keystatic `pages` blocks entry) since the grid must reflect every case automatically.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InnerHero from '../components/blocks/InnerHero.astro';
import TalkToUs from '../components/blocks/TalkToUs.astro';
import { blockImg } from '../lib/img';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const slugs = await reader.collections.businessCases.list();
const cases = (
  await Promise.all(slugs.map(async (slug) => ({ slug, entry: await reader.collections.businessCases.read(slug) })))
).filter(({ entry }) => entry && entry.lang === 'fr');
---
<Layout
  lang="fr"
  title="Nos réalisations — Agitech"
  description="Rejoignez 140 entreprises qui nous font confiance. Découvrez nos business cases Odoo."
  canonical="https://agitech.io/case-study/"
>
  <Header slot="header" lang="fr" />
  <main>
    <InnerHero title="Nous mesurons notre succès aux résultats" subTitle="Rejoignez 140 entreprises qui nous font confiance" bottomLine={true} />
    <section class="we-implemented-section lighter-gray-bg">
      <div class="container">
        <div class="row items-wrap">
          {cases.map(({ slug, entry }) => (
            <div class="item">
              <a href={`/business-cases/${slug}/`}>
                <div class="field">
                  <div class="img">{entry.coverImage && <img src={blockImg(entry.coverImage)} alt={entry.title}>}</div>
                  <div class="content">
                    {entry.industry && <div class="case_types"><span class="green-text">{entry.industry}</span></div>}
                    <h6>{entry.client || entry.title}</h6>
                  </div>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
    <TalkToUs
      bgClass="white-bg"
      image="sam-profile.jpg"
      title="Parlez de votre projet avec Sam"
      subTitle="Pas de commercial chez Agitech, on se parle directement entre patron de PME."
      contentDetails="<p>Besoin d'un avis franc, d'une estimation budgétaire à la volée ? Vous pouvez directement réserver un visio call avec moi via le lien ci-dessous.</p><p>Si votre demande est urgente, vous pouvez m'écrire à l'adresse suivante: Sam (at) agitech.io</p>"
      cta={{ label: 'Discuter avec Sam', url: '/contact-us/' }}
    />
  </main>
  <Footer slot="footer" lang="fr" />
</Layout>
