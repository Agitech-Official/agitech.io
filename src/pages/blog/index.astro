---
// Blog listing — reads the blog collection directly (not a Keystatic `pages` blocks
// entry) since the grid must reflect every post automatically.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import InnerHero from '../../components/blocks/InnerHero.astro';
import TalkToUs from '../../components/blocks/TalkToUs.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const slugs = await reader.collections.blog.list();
const posts = (
  await Promise.all(slugs.map(async (slug) => ({ slug, entry: await reader.collections.blog.read(slug) })))
)
  .filter(({ entry }) => entry && entry.lang === 'fr')
  .sort((a, b) => (b.entry.publishedAt ?? '').localeCompare(a.entry.publishedAt ?? ''));
---
<Layout
  lang="fr"
  title="Blog Odoo & ERP : guides et conseils | Agitech"
  description="Guides pratiques sur Odoo, le choix d'un ERP, le budget, la migration et la gouvernance de projet. Retours terrain d'un partenaire Odoo belge."
  canonical="https://agitech.io/blog/"
>
  <Header slot="header" lang="fr" />
  <main>
    <InnerHero title="Le Blog d'Agitech" subTitle="Nos réflexions, nos méthodes, nos retours terrain." bottomLine={true} />
    <section class="blog-listing-section lighter-gray-bg">
      <div class="container">
        <div class="row items-wrap blog-wrap">
          {posts.map(({ slug, entry }) => (
            <div class="item">
              <a href={`/${slug}/`}>
                <div class="field">
                  <div class="content">
                    {entry.category && <div class="case_types"><span class="green-text">{entry.category}</span></div>}
                    <h6>{entry.title}</h6>
                    {entry.excerpt && <p>{entry.excerpt}</p>}
                    {entry.publishedAt && <span class="post-date">{entry.publishedAt}</span>}
                  </div>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
    <TalkToUs
      bgClass="white-bg"
      image="sam-profile.jpg"
      title="Parlez de votre projet avec Sam"
      subTitle="Pas de commercial chez Agitech, on se parle directement entre patron de PME."
      contentDetails="<p>Besoin d'un avis franc, d'une estimation budgétaire à la volée ? Vous pouvez directement réserver un visio call avec moi via le lien ci-dessous.</p><p>Si votre demande est urgente, vous pouvez m'écrire à l'adresse suivante: Sam (at) agitech.io</p>"
      cta={{ label: 'Discuter avec Sam', url: '/contact-us/' }}
    />
  </main>
  <Footer slot="footer" lang="fr" />
</Layout>
