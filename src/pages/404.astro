---
// Same markup as the WP theme's 404.php ("error" section, centered), with the copy WordPress left in
// English translated. One page for every language: Vercel serves /404.html for any unknown URL.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout lang="fr" title="Page introuvable - Agitech - Odoo Partner" description="" canonical={false} robotsNoIndex>
  <Header slot="header" lang="fr" />
  <main>
    <section class="error">
      <div class="container">
        <div class="row">
          <div class="col-lg-6 offset-lg-3 text-center">
            <h2>Page introuvable</h2>
            <p>La page que vous cherchez n'existe pas ou a été déplacée.</p>
            <a href="/" class="primary_btn">Retour à l'accueil</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer slot="footer" lang="fr" />
</Layout>
