---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlockRenderer from '../../components/BlockRenderer.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import { headingOf } from '../../lib/seo';

const reader = createReader(process.cwd(), keystaticConfig);
const page = await reader.collections.pages.read('accueil-nl');
if (!page) throw new Error('Missing Keystatic entry: pages/accueil-nl');
const blocks = page.blocks;

const faqBlock = blocks.find((b) => b.discriminant === 'faq');
const jsonLd = faqBlock
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: (faqBlock.value.items ?? []).map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : undefined;
---
<Layout
  lang="nl"
  title={page.seoTitle || page.title}
  description={page.seoDescription ?? ''}
  canonical="https://agitech.io/nl/"
  jsonLd={jsonLd}
  includeContactScripts
>
  <Header slot="header" lang="nl" />
  <main>
    <h1 class="visually-hidden-h1">{headingOf(page)}</h1>
    <BlockRenderer blocks={blocks.slice(0, 1)} />
    <div class="brand-bar"></div>
    <BlockRenderer blocks={blocks.slice(1)} />
  </main>
  <Footer slot="footer" lang="nl" />
</Layout>
