---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import InnerHero from '../../../components/blocks/InnerHero.astro';
import TalkToUs from '../../../components/blocks/TalkToUs.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const slugs = await reader.collections.blog.list();
const posts = (
  await Promise.all(slugs.map(async (slug) => ({ slug, entry: await reader.collections.blog.read(slug) })))
)
  .filter(({ entry }) => entry && entry.lang === 'nl')
  .sort((a, b) => (b.entry.publishedAt ?? '').localeCompare(a.entry.publishedAt ?? ''));
---
<Layout
  lang="nl"
  title="Odoo & ERP-blog voor KMO's: gidsen en tips | Agitech"
  description="Praktische gidsen over Odoo, ERP-keuze, budget, migratie en projectgovernance. Ervaringen uit het veld van een Belgische Odoo-partner."
  canonical="https://agitech.io/nl/blog/"
>
  <Header slot="header" lang="nl" />
  <main>
    <InnerHero title="De Agitech Blog" subTitle="Onze inzichten, onze methodes, onze praktijkervaring." bottomLine={true} />
    <section class="blog-listing-section lighter-gray-bg">
      <div class="container">
        <div class="row items-wrap blog-wrap">
          {posts.map(({ slug, entry }) => (
            <div class="item">
              <a href={`/nl/${slug.replace(/-nl$/, '')}/`}>
                <div class="field">
                  <div class="content">
                    {entry.category && <div class="case_types"><span class="green-text">{entry.category}</span></div>}
                    <h6>{entry.title}</h6>
                    {entry.excerpt && <p>{entry.excerpt}</p>}
                    {entry.publishedAt && <span class="post-date">{entry.publishedAt}</span>}
                  </div>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
    <TalkToUs
      bgClass="white-bg"
      image="sam-profile.jpg"
      title="Praat met Sam over uw project"
      subTitle="Geen verkoper bij Agitech, we praten rechtstreeks van KMO-eigenaar tot KMO-eigenaar."
      contentDetails="<p>Nood aan een eerlijke mening of een snelle budgetraming? U kan rechtstreeks een videogesprek met mij boeken via de link hieronder.</p><p>Bij een dringende vraag kan u mij ook rechtstreeks mailen op: Sam (at) agitech.io</p>"
      cta={{ label: 'Praat met Sam', url: '/nl/contact-us/' }}
    />
  </main>
  <Footer slot="footer" lang="nl" />
</Layout>
