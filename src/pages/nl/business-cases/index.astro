---
// NL mirror of business-cases/index.astro.
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FeaturedCases from '../../../components/blocks/FeaturedCases.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const slugs = await reader.collections.businessCases.list();
const entries = await Promise.all(
  slugs.map(async (slug) => ({ slug, entry: await reader.collections.businessCases.read(slug) }))
);
const cases = entries
  .filter(({ entry }) => entry && entry.lang === 'nl')
  .map(({ slug, entry }) => ({
    title: entry!.title,
    href: `/nl/business-cases/${slug.replace(/-nl$/, '')}/`,
    image: entry!.coverImage ?? undefined,
    caseType: entry!.industry ?? undefined,
  }));
---
<Layout
  lang="nl"
  title="Realisaties — Agitech"
  description="Odoo-projecten gerealiseerd door Agitech voor haar klanten: ERP, e-commerce, maatwerkontwikkeling."
  canonical="https://agitech.io/nl/business-cases/"
>
  <Header slot="header" lang="nl" />
  <main>
    <section class="banner-sec inner-pages-banner dark-bg">
      <div class="container">
        <div class="row">
          <div class="col-lg-12 col-md-12 col-sm-12 col-12">
            <div class="text">
              <h6>Ons werk</h6>
              <h1>Realisaties</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <FeaturedCases cases={cases} />
  </main>
  <Footer slot="footer" lang="nl" />
</Layout>
