---
// Réalisations hub — lists every FR business case. Individual pages already exist at
// business-cases/[slug].astro; this just adds the missing index/listing route.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FeaturedCases from '../../components/blocks/FeaturedCases.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const slugs = await reader.collections.businessCases.list();
const entries = await Promise.all(
  slugs.map(async (slug) => ({ slug, entry: await reader.collections.businessCases.read(slug) }))
);
const cases = entries
  .filter(({ entry }) => entry && entry.lang === 'fr')
  .map(({ slug, entry }) => ({
    title: entry!.title,
    href: `/business-cases/${slug}/`,
    image: entry!.coverImage ?? undefined,
    caseType: entry!.industry ?? undefined,
  }));
---
<Layout
  lang="fr"
  title="Réalisations — Agitech"
  description="Les projets Odoo réalisés par Agitech pour ses clients : ERP, e-commerce, développements sur mesure."
  canonical="https://agitech.io/business-cases/"
>
  <Header slot="header" lang="fr" />
  <main>
    <section class="banner-sec inner-pages-banner dark-bg">
      <div class="container">
        <div class="row">
          <div class="col-lg-12 col-md-12 col-sm-12 col-12">
            <div class="text">
              <h6>Notre travail</h6>
              <h1>Réalisations</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <FeaturedCases cases={cases} />
  </main>
  <Footer slot="footer" lang="fr" />
</Layout>
