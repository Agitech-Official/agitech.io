---
import { faqPlain } from '../lib/faqText';
// Generic renderer for FR content living at the site root: Keystatic `pages` entries
// (page-builder blocks) and `blog` entries (markdoc article body) share this one route
// since both use flat root URLs on the live site (no /blog/ prefix on post URLs).
// The homepage is excluded — it lives at "/" via a dedicated index.astro.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlockRenderer from '../components/BlockRenderer.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import Markdoc from '@markdoc/markdoc';
import { addTocIds } from '../lib/toc';

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);

  const pageSlugs = await reader.collections.pages.list();
  const pageEntries = await Promise.all(
    pageSlugs
      .filter((slug) => slug !== 'accueil')
      .map(async (slug) => ({ slug, entry: await reader.collections.pages.read(slug) }))
  );
  const pagePaths = pageEntries
    .filter(({ entry }) => entry && entry.lang === 'fr')
    .map(({ slug, entry }) => ({ params: { slug }, props: { kind: 'page', entry } }));

  const blogSlugs = await reader.collections.blog.list();
  const blogEntries = await Promise.all(
    blogSlugs.map(async (slug) => ({ slug, entry: await reader.collections.blog.read(slug) }))
  );
  const blogPaths = blogEntries
    .filter(({ entry }) => entry && entry.lang === 'fr')
    .map(({ slug, entry }) => ({ params: { slug }, props: { kind: 'blog', entry } }));

  return [...pagePaths, ...blogPaths];
}

const { kind, entry } = Astro.props;

let bodyHtml = '';
let toc: { id: string; text: string }[] = [];
if (kind === 'blog') {
  const { node } = await entry.body();
  const rendered = Markdoc.renderers.html(Markdoc.transform(node));
  const withToc = addTocIds(rendered);
  bodyHtml = withToc.html;
  toc = withToc.toc;
}
const hasContactHero = kind === 'page' && entry.blocks?.some((b: { discriminant: string }) => b.discriminant === 'contactHero' || b.discriminant === 'officeContactHero');

const pageFaqBlock = kind === 'page' ? entry.blocks?.find((b: any) => b.discriminant === 'faq') : undefined;
const pageJsonLd = pageFaqBlock
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: (pageFaqBlock.value.items ?? []).map((item: any) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: faqPlain(item.answer) },
      })),
    }
  : undefined;
const blogUrl = `https://agitech.io/${Astro.params.slug}/`;
const blogJsonLd = kind === 'blog' ? [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.title,
    description: entry.seoDescription || entry.excerpt || undefined,
    datePublished: entry.publishedAt || undefined,
    dateModified: entry.publishedAt || undefined,
    inLanguage: 'fr-BE',
    mainEntityOfPage: blogUrl,
    author: { '@type': 'Organization', name: 'Agitech', url: 'https://agitech.io/' },
    publisher: { '@type': 'Organization', name: 'Agitech', url: 'https://agitech.io/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://agitech.io/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://agitech.io/blog/' },
      { '@type': 'ListItem', position: 3, name: entry.title, item: blogUrl },
    ],
  },
] : undefined;
---
{kind === 'page' ? (
  <Layout
    lang="fr"
    title={entry.seoTitle || entry.title}
    description={entry.seoDescription ?? ''}
    canonical={`https://agitech.io/${Astro.params.slug}/`}
    robotsNoIndex={['erp-sea', 'landing-page-sea-pb'].includes(Astro.params.slug) || undefined}
    includeContactScripts={hasContactHero}
    jsonLd={pageJsonLd}
  >
    <Header slot="header" lang="fr" />
    <main>
      <BlockRenderer blocks={entry.blocks} />
    </main>
    <Footer slot="footer" lang="fr" />
  </Layout>
) : (
  <Layout
    lang="fr"
    title={entry.seoTitle || entry.title}
    description={entry.seoDescription || entry.excerpt || bodyHtml.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 155)}
    canonical={`https://agitech.io/${Astro.params.slug}/`}
    jsonLd={blogJsonLd}
  >
    <Header slot="header" lang="fr" />
    <main>
      <section class="blog-details-section">
        <div class="container-sm">
          <div class="row header-area">
            <div class="col-12">
              {entry.category && <div class="categories-btn"><span class="purple-text">{entry.category}</span></div>}
              <h1>{entry.title}</h1>
              {entry.publishedAt && <div class="name-date"><p>{entry.publishedAt}</p></div>}
            </div>
          </div>
          <div class="row content-area">
            {toc.length > 1 && (
              <aside class="col-lg-3 toc-sidebar">
                <nav>
                  <h6>Sommaire</h6>
                  <ol>{toc.map(t => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
                </nav>
              </aside>
            )}
            <div class={toc.length > 1 ? 'col-lg-9' : 'col-lg-12'} set:html={bodyHtml} />
          </div>
        </div>
      </section>
    </main>
    <Footer slot="footer" lang="fr" />
  </Layout>
)}

<style>
  /* InnerHero renders its headline as h6/h2 (shared across every inner page), so this
     page's real h1 is added here instead — visually hidden, present for a11y/SEO,
     scoped to this file only. */
  .visually-hidden-h1 {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
</style>
