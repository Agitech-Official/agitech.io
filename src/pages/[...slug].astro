---
// Generic renderer for FR content living at the site root: Keystatic `pages` entries
// (page-builder blocks) and `blog` entries (markdoc article body) share this one route
// since both use flat root URLs on the live site (no /blog/ prefix on post URLs).
// The homepage is excluded — it lives at "/" via a dedicated index.astro.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlockRenderer from '../components/BlockRenderer.astro';
import Markdoc from '@markdoc/markdoc';
import { pageAndPostPaths } from '../lib/content';
import PostArticle from '../components/PostArticle.astro';
import { headingOf, pageSeo, postSeo } from '../lib/seo';

export async function getStaticPaths() {
  return pageAndPostPaths('fr');
}

const { kind, entry } = Astro.props;

let bodyHtml = '';
if (kind === 'blog') {
  if (entry.contentHtml) {
    bodyHtml = entry.contentHtml;
  } else {
    const { node } = await entry.body();
    bodyHtml = Markdoc.renderers.html(Markdoc.transform(node));
  }
}
const seo = kind === 'blog' ? await postSeo(entry) : pageSeo(entry);
const hasContactHero = kind === 'page' && entry.blocks?.some((b: { discriminant: string }) => b.discriminant === 'contactHero');

const pageFaqBlock = kind === 'page' ? entry.blocks?.find((b: any) => b.discriminant === 'faq') : undefined;
const pageJsonLd = pageFaqBlock
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: (pageFaqBlock.value.items ?? []).map((item: any) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : undefined;
---
{kind === 'page' ? (
  <Layout
    lang="fr"
    title={entry.seoTitle || entry.title}
    description={entry.seoDescription ?? ''}
    includeContactScripts={hasContactHero}
    {...seo}
    jsonLd={pageJsonLd}
  >
    <Header slot="header" lang="fr" />
    <main>
      {!entry.blocks?.some((b: { discriminant: string }) => b.discriminant === 'cmsPage') && <h1 class="visually-hidden-h1">{headingOf(entry)}</h1>}
      <BlockRenderer blocks={entry.blocks} />
    </main>
    <Footer slot="footer" lang="fr" />
  </Layout>
) : (
  <Layout
    lang="fr"
    bodyClass="post-template-default single single-post"
    {...seo}
    title={entry.seoTitle || entry.title}
    description={entry.seoDescription || entry.excerpt || ''}
  >
    <Header slot="header" lang="fr" />
    <main>
      <h1 class="visually-hidden-h1">{entry.title}</h1>
      <PostArticle lang="fr" slug={Astro.params.slug} entry={entry} bodyHtml={bodyHtml} />
    </main>
    <Footer slot="footer" lang="fr" />
  </Layout>
)}
