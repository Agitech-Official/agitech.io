---
import { faqPlain } from '../lib/faqText';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlockRenderer from '../components/BlockRenderer.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const page = await reader.collections.pages.read('accueil');
if (!page) throw new Error('Missing Keystatic entry: pages/accueil');
const blocks = page.blocks;

const faqBlock = blocks.find((b) => b.discriminant === 'faq');
const jsonLd = faqBlock
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: (faqBlock.value.items ?? []).map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: faqPlain(item.answer) },
      })),
    }
  : undefined;
---
<Layout
  lang="fr"
  title={page.seoTitle || page.title}
  description={page.seoDescription ?? ''}
  canonical="https://agitech.io/"
  bodyClass="is-home"
  jsonLd={jsonLd}
  includeContactScripts
>
  <Header slot="header" lang="fr" />
  <main>
    <BlockRenderer blocks={blocks.slice(0, 1)} />
    <div class="brand-bar"></div>
    <BlockRenderer blocks={blocks.slice(1)} />
  </main>
  <Footer slot="footer" lang="fr" />
</Layout>
