---
export interface Props {
  lang: 'fr' | 'en' | 'nl';
  title: string;
  description: string;
  canonical?: string;
  ogLocale?: string;
  jsonLd?: Record<string, unknown>;
  robotsNoIndex?: boolean;
  /** Absolute or site-relative social preview image (defaults to the generic Agitech card). */
  image?: string;
  /** Set on the homepage only — flips the dark-section corner glow to the opposite
   * corner from every other page (see .is-home rules in style.css). */
  bodyClass?: string;
  /** Calendly widget + the postMessage listener that redirects to the "merci-rdv"
   * thank-you page on booking — only needed on pages with the Calendly embed. */
  includeContactScripts?: boolean;
}

const localeMap = { fr: 'fr_BE', en: 'en_US', nl: 'nl_BE' };
const {
  lang, title, description,
  canonical, ogLocale = localeMap[lang],
  jsonLd, image,
  // Defaults to noindex until PUBLIC_INDEXABLE=true is set in the Vercel project (go-live
  // switch — see src/pages/robots.txt.ts, which reads the same variable). Pages that pass
  // robotsNoIndex explicitly (thank-you, 404) stay noindex either way.
  robotsNoIndex = import.meta.env.PUBLIC_INDEXABLE !== 'true',
  bodyClass,
  includeContactScripts = false,
} = Astro.props;

// Tracking carried over from the WordPress theme (header.php / header-odoo.php /
// template-odoo-landing.php / thank-you templates). Production only, so dev traffic
// never pollutes the analytics.
const GTM_ID = 'GTM-P7LT3M5';
const ADS_ID = 'AW-10889064569';
const pathname = Astro.url.pathname.replace(/^\/(en|nl)(?=\/)/, '');
const isProd = import.meta.env.PROD;
const isAdsLanding = /^\/(odoo-erp|erp-sea|landing-page-sea-pb)\/?$/.test(pathname);
const isSeaLanding = /^\/(erp-sea|landing-page-sea-pb)\/?$/.test(pathname);
const isThankYou = /^\/(merci-rdv|merci-formulaire|thank-you-meeting|thank-you-form)\/?$/.test(pathname);
const needsGtag = isProd && (isAdsLanding || isThankYou);

const SITE_URL = 'https://agitech.io';
const ogImage = image ? (image.startsWith('http') ? image : `${SITE_URL}${image}`) : `${SITE_URL}/assets/img/og-default.png`;
const consent = {
  fr: { text: 'Nous utilisons des cookies de mesure d’audience et publicitaires pour améliorer le site et mesurer nos campagnes. Vous pouvez les accepter ou les refuser.', accept: 'Accepter', refuse: 'Refuser', more: 'Politique de confidentialité', manage: 'Gérer les cookies', privacy: '/privacy-policy/' },
  en: { text: 'We use analytics and advertising cookies to improve the site and measure our campaigns. You can accept or refuse them.', accept: 'Accept', refuse: 'Refuse', more: 'Privacy policy', manage: 'Manage cookies', privacy: '/en/privacy-policy/' },
  nl: { text: 'Wij gebruiken analytische en advertentiecookies om de site te verbeteren en onze campagnes te meten. U kunt ze aanvaarden of weigeren.', accept: 'Aanvaarden', refuse: 'Weigeren', more: 'Privacybeleid', manage: 'Cookies beheren', privacy: '/nl/privacy-policy/' },
}[lang];

const isHome = /^\/(en\/|nl\/)?$/.test(Astro.url.pathname);
const addr = (street: string, postalCode: string, city: string) => ({
  '@type': 'PostalAddress', streetAddress: street, postalCode, addressLocality: city, addressCountry: 'BE',
});
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Agitech',
  url: 'https://agitech.io/',
  logo: 'https://agitech.io/assets/img/agitech-logo-dark.svg',
  telephone: '+32 2 616 69 87',
  sameAs: ['https://www.linkedin.com/company/agitechbelgium/', 'https://www.youtube.com/@Agitech-OdooPartner'],
  location: [
    { '@type': 'Place', name: 'Agitech Bruxelles', address: addr('Clos Lucien Outers 11', '1160', 'Auderghem') },
    { '@type': 'Place', name: 'Agitech Bouillon', address: addr('Grand-Rue 17', '6830', 'Bouillon') },
    { '@type': 'Place', name: 'Agitech Anvers', address: addr('Frankrijklei 5', '2000', 'Antwerpen') },
  ],
};

const rdvThankYouPath = lang === 'en' ? '/en/thank-you-meeting/' : lang === 'nl' ? '/nl/thank-you-meeting/' : '/merci-rdv/';

// FR = default locale (no prefix), EN and NL under /en/ and /nl/ — matches current
// WP/Polylang URL shape for FR/EN, NL added the same way. hreflang needs every
// language's URL for the same page, so strip whichever prefix this page has, then
// rebuild all three.
const SITE = 'https://agitech.io';
const barePath = canonical
  ? canonical.replace(SITE, '').replace(/^\/(en|nl)(\/|$)/, '/')
  : undefined;
const altLinks = barePath
  ? [
      { hreflang: 'fr', href: `${SITE}${barePath}` },
      { hreflang: 'en', href: `${SITE}/en${barePath}` },
      { hreflang: 'nl', href: `${SITE}/nl${barePath}` },
    ]
  : [];
---
<!DOCTYPE html>
<html lang={lang}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{robotsNoIndex && <meta name="robots" content="noindex, nofollow">}
<title>{title}</title>
<meta name="description" content={description}>
{canonical && (
  <>
    <link rel="canonical" href={canonical}>
    {altLinks.map(a => <link rel="alternate" hreflang={a.hreflang} href={a.href}>)}
    <link rel="alternate" hreflang="x-default" href="https://agitech.io/">
    <meta property="og:type" content="website">
    <meta property="og:locale" content={ogLocale}>
    <meta property="og:url" content={canonical}>
    <meta property="og:site_name" content="Agitech">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImage}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>
  </>
)}
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
{isHome && <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />}
<!-- Same base design system as agifid.be (fonts, tokens, layout primitives), recolored to
     Agitech's own mauve (#984895, from the official wordmark) instead of agifid's teal. -->
<link rel="preload" href="/assets/fonts/SpaceGrotesk-300.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/SpaceGrotesk-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/DMSans-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/fonts.css">
<link rel="stylesheet" href="/assets/style.css">
</head>
<body class={bodyClass}>
<slot name="header" />
<slot />
<slot name="footer" />
{isProd && (
  <div id="cookie-banner" class="cookie-banner" role="dialog" aria-label={consent.manage} hidden>
    <p>{consent.text} <a href={consent.privacy}>{consent.more}</a></p>
    <div class="cookie-actions">
      <button type="button" class="cookie-refuse" data-consent="denied">{consent.refuse}</button>
      <button type="button" class="cookie-accept" data-consent="granted">{consent.accept}</button>
    </div>
  </div>
  <script is:inline define:vars={{ GTM_ID, ADS_ID, needsGtag, isThankYou, isSeaLanding }}>
    // Analytics / ads / Clarity only load after an explicit "accept" (stored in localStorage).
    // "Manage cookies" links (data-cookie-settings) re-open the banner.
    (function () {
      var KEY = 'agitech-consent';
      function load(src) { var s = document.createElement('script'); s.async = true; s.src = src; document.head.appendChild(s); }
      function startTracking() {
        if (window.__trackingStarted) return; window.__trackingStarted = true;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        load('https://www.googletagmanager.com/gtm.js?id=' + GTM_ID);
        if (needsGtag) {
          load('https://www.googletagmanager.com/gtag/js?id=' + ADS_ID);
          window.gtag = function () { window.dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', ADS_ID);
          if (isSeaLanding) {
            gtag('config', ADS_ID + '/Y22HCI_ynLwZEPngp8go', { phone_conversion_number: '26166987' });
            gtag('config', ADS_ID + '/MLDdCP-FnbwZEPngp8go', { phone_conversion_number: '+32 (2) 616 69 87' });
          }
          if (isThankYou) gtag('event', 'conversion', { send_to: ADS_ID + '/LQJhCMGcj9AZEPngp8go' });
        }
        if (isSeaLanding) {
          (function (c, l, a, r, i, t, y) { c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
            t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
            y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y); })(window, document, 'clarity', 'script', 'mvdguyhsd9');
        }
      }
      var banner = document.getElementById('cookie-banner');
      var saved = null; try { saved = localStorage.getItem(KEY); } catch (e) {}
      if (saved === 'granted') startTracking();
      else if (!saved && banner) banner.hidden = false;
      banner && banner.addEventListener('click', function (e) {
        var v = e.target && e.target.getAttribute && e.target.getAttribute('data-consent');
        if (!v) return;
        try { localStorage.setItem(KEY, v); } catch (err) {}
        banner.hidden = true;
        if (v === 'granted') startTracking();
      });
      document.addEventListener('click', function (e) {
        if (e.target && e.target.closest && e.target.closest('[data-cookie-settings]')) { e.preventDefault(); if (banner) banner.hidden = false; }
      });
    })();
  </script>
)}
<script>
  const burgerBtn = document.getElementById('burgerBtn');
  const mainMenu = document.getElementById('mainMenu');
  burgerBtn?.addEventListener('click', () => mainMenu?.classList.toggle('open'));
  // Mobile drawer: sub-menus are collapsed accordions, opened with the chevron button.
  document.querySelectorAll('.submenu-toggle').forEach((btn) => btn.addEventListener('click', () => {
    const li = btn.closest('.has-submenu');
    const open = li?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
  }));
</script>
{includeContactScripts && (
  <script is:inline define:vars={{ rdvThankYouPath }}>
    // Calendly is a heavy third-party script only needed once the visitor reaches the
    // contact section — loaded lazily on scroll-into-view instead of on every page load.
    let calendlyPromise = null;
    function loadCalendly() {
      if (!calendlyPromise) {
        calendlyPromise = new Promise((resolve) => {
          const s = document.createElement('script');
          s.src = 'https://assets.calendly.com/assets/external/widget.js';
          s.onload = resolve;
          document.body.appendChild(s);
        });
      }
      return calendlyPromise;
    }
    const contactSection = document.getElementById('contact');
    if (contactSection) {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          loadCalendly();
          observer.disconnect();
        }
      }, { rootMargin: '600px' });
      observer.observe(contactSection);
    }

    window.addEventListener('message', (e) => {
      if (e.origin !== 'https://calendly.com' || !e.data || !e.data.event) return;

      // The embedded Calendly widget has its own confirmation inside the iframe: without
      // this, a booking never goes through a thank-you page and is never tracked.
      if (e.data.event === 'calendly.event_scheduled') {
        window.location.href = rdvThankYouPath;
      }

      // Calendly defaults to a fixed height, which creates a scroll inside the iframe (a
      // "page inside the page"). Resync the widget's height to its real content so only
      // the page itself scrolls.
      if (e.data.event === 'calendly.page_height') {
        const widget = document.querySelector('.calendly-inline-widget');
        if (widget && e.data.payload && e.data.payload.height) {
          widget.style.height = e.data.payload.height + 'px';
        }
      }
    });
  </script>
)}
</body>
</html>
