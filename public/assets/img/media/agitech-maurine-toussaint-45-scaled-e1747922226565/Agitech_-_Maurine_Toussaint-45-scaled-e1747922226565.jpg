    <script>
    document.addEventListener('wpcf7mailsent', function(event) {
      const form = event.target;
      const formWrap = form.querySelector('.form-wrp');
      const customSuccess = form.querySelector('.success-mess');

      if (customSuccess) {
        formWrap.style.display = 'none';

        // instantly swap content, no delay
        customSuccess.innerHTML = cf7Messages.success;
        customSuccess.classList.add('active');
      }
    }, false);

    </script>

