# Environment variables of the site. Copy to .env for local work; on Vercel set them per environment
# (Project → Settings → Environment Variables). Never commit real values.

# --- Go-live switches (build time: change = redeploy) ---------------------------------------------------
# Set to "true" on the Production environment ONLY, at go-live. Until then every page is noindex and
# robots.txt disallows everything, so previews never compete with the live WordPress site.
PUBLIC_INDEXABLE=
# Google Tag Manager container (GTM-P7LT3M5 on the WordPress site). Production only: previews must not
# send pageviews or Ads conversions to the live accounts.
PUBLIC_GTM_ID=

# --- Drafts ---------------------------------------------------------------------------------------------
# "true" on the Preview environment ONLY: contents ticked "Brouillon" are built so editors can review them.
# Never on Production. (Always on in local development.)
PUBLIC_SHOW_DRAFTS=

# --- Keystatic (editor at /keystatic, GitHub storage in production) ------------------------------------
# From the GitHub App created on first login (see docs/phase5-notes.md). Not needed in local development.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# Repository the editor writes to (Production and Preview). Change it if the repository moves to another organisation.
PUBLIC_KEYSTATIC_REPO=Diego-Agitech/agitech.io
# Local development only: "github" lets /keystatic run the "create the GitHub App" setup instead of editing local files.
PUBLIC_KEYSTATIC_STORAGE=

# --- Odoo budget estimator (/simulateur/, POST /api/send-estimate) --------------------------------------
MONGODB_URI=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
